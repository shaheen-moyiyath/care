  <div class="section-card">
    <div class="header-box">
      4. Main Express Server Entrypoint
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>backend/server.js</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">2. BACKEND CONFIGURATION & ENTRY</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>The root application file that bootstraps the Express server, applies security and CORS middleware, registers all RESTful route groups (/api/auth, /api/patient, /api/doctor, /api/admin, /api/notifications), provides a health check route, and initializes database connection pools.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">require('dotenv').config();
const express = require('express');
const cors = require('cors');
const morgan = require('morgan');
const { initDatabase } = require('./database/db');

const authRoutes = require('./routes/authRoutes');
const patientRoutes = require('./routes/patientRoutes');
const doctorRoutes = require('./routes/doctorRoutes');
const adminRoutes = require('./routes/adminRoutes');
const notificationRoutes = require('./routes/notificationRoutes');

const app = express();
const PORT = process.env.PORT || 5000;

// Middlewares
app.use(cors({
  origin: '*',
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization']
}));
app.use(express.json());
app.use(morgan('dev'));

// API Routes
app.use('/api/auth', authRoutes);
app.use('/api/patient', patientRoutes);
app.use('/api/doctor', doctorRoutes);
app.use('/api/admin', adminRoutes);
app.use('/api/notifications', notificationRoutes);

// Health Check &amp; Root
app.get('/api/health', (req, res) =&gt; {
  res.json({
    status: 'online',
    service: 'Online Patient Appointment System (OPAS) API',
    timestamp: new Date().toISOString()
  });
});

// Error handling middleware
app.use((err, req, res, next) =&gt; {
  console.error('Unhandled Server Error:', err);
  res.status(500).json({
    success: false,
    message: 'Internal server error occurred.',
    error: process.env.NODE_ENV === 'development' ? err.message : undefined
  });
});

// Start Server after Database Initialization
async function startServer() {
  try {
    await initDatabase();
    app.listen(PORT, () =&gt; {
      console.log(`🚀 OPAS Backend Server listening on http://localhost:${PORT}`);
    });
  } catch (error) {
    console.error('❌ Failed to initialize database / start server:', error);
    process.exit(1);
  }
}

startServer();
</div>
