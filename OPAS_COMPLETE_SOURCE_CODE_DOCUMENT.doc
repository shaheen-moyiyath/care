        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import {
  HeartPulse,
  CalendarCheck,
  Stethoscope,
  ShieldCheck,
  Clock,
  ArrowRight,
  Activity,
  Brain,
  Bone,
  Sparkles,
  Users,
  CheckCircle2,
  Lock,
  ChevronRight
} from 'lucide-react';
import api from '../services/api';

const LandingPage = () =&gt; {
  const { quickDemoLogin, isAuthenticated, user } = useAuth();
  const navigate = useNavigate();
  const [doctors, setDoctors] = useState([]);
  const [selectedSpec, setSelectedSpec] = useState('All');
  const [loading, setLoading] = useState(true);

  useEffect(() =&gt; {
    fetchFeaturedDoctors();
  }, []);

  const fetchFeaturedDoctors = async () =&gt; {
    try {
      const res = await api.get('/patient/doctors');
      if (res.data.success) {
        setDoctors(res.data.doctors || []);
      }
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const handleDemoLogin = async (role) =&gt; {
    const res = await quickDemoLogin(role);
    if (res.success) {
      if (role === 'admin') navigate('/admin/dashboard');
      else if (role === 'doctor') navigate('/doctor/dashboard');
      else navigate('/patient/dashboard');
    }
  };

  const specialties = [
    {
      id: 'Cardiology',
      name: 'Cardiology',
      icon: HeartPulse,
      desc: 'Expert heart health diagnostics, ECG review &amp; vascular care',
      color: 'from-rose-500 to-red-600',
      badge: 'Heart Care'
    },
    {
      id: 'Neurology',
      name: 'Neurology',
      icon: Brain,
      desc: 'Specialized brain, migraine, neuropathy &amp; spinal assessments',
      color: 'from-indigo-500 to-purple-600',
      badge: 'Neuro Health'
    },
    {
      id: 'Orthopedics',
      name: 'Orthopedics',
      icon: Bone,
      desc: 'Joint replacement, trauma care, fracture &amp; surgical evaluation',
      color: 'from-amber-500 to-orange-600',
      badge: 'Joints &amp; Bones'
    },
    {
      id: 'Dermatology',
      name: 'Dermatology',
      icon: Sparkles,
      desc: 'Skin conditions, allergy screening &amp; dermatological therapies',
      color: 'from-teal-500 to-cyan-600',
      badge: 'Skin &amp; Aesthetics'
    }
  ];

  const filteredDoctors = selectedSpec === 'All'
    ? doctors
    : doctors.filter(d =&gt; d.Specialization.toLowerCase() === selectedSpec.toLowerCase());

  return (
    &lt;div className="min-h-screen bg-slate-50 flex flex-col"&gt;
      {/* Hero Section */}
      &lt;section className="relative overflow-hidden bg-gradient-to-b from-teal-900 via-slate-900 to-slate-900 text-white pt-20 pb-28"&gt;
        &lt;div className="absolute inset-0 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:24px_24px] opacity-15"&gt;&lt;/div&gt;
        &lt;div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"&gt;
          &lt;div className="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"&gt;
            {/* Left Hero Text */}
            &lt;div className="lg:col-span-7 space-y-6"&gt;
              &lt;div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-500/20 border border-teal-500/30 text-teal-300 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm"&gt;
                &lt;Activity className="w-3.5 h-3.5" /&gt; Next-Generation Medical Scheduling
              &lt;/div&gt;

              &lt;h1 className="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight"&gt;
                Seamless Healthcare. &lt;br /&gt;
                &lt;span className="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-cyan-300 to-blue-400"&gt;
                  Zero Double-Bookings.
                &lt;/span&gt;
              &lt;/h1&gt;

              &lt;p className="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed"&gt;
                CareConnect Online Patient Appointment System provides real-time specialist availability, conflict-free booking, clinical disease evaluation, and streamlined administration in one unified platform.
              &lt;/p&gt;

              &lt;div className="flex flex-wrap gap-4 pt-4"&gt;
                {isAuthenticated ? (
                  &lt;Link
                    to={user?.role === 'admin' ? '/admin/dashboard' : user?.role === 'doctor' ? '/doctor/dashboard' : '/patient/dashboard'}
                    className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold shadow-lg shadow-teal-500/30 transition-all transform hover:-translate-y-0.5"
                  &gt;
                    Go to Your Dashboard &lt;ArrowRight className="w-5 h-5" /&gt;
                  &lt;/Link&gt;
                ) : (
                  &lt;&gt;
                    &lt;Link
                      to="/register"
                      className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold shadow-lg shadow-teal-500/30 transition-all transform hover:-translate-y-0.5"
                    &gt;
                      Book Appointment Now &lt;ArrowRight className="w-5 h-5" /&gt;
                    &lt;/Link&gt;
                    &lt;Link
                      to="/login"
                      className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-white font-semibold border border-slate-700 transition-all"
                    &gt;
                      Sign In to Account
                    &lt;/Link&gt;
                  &lt;/&gt;
                )}
              &lt;/div&gt;

              {/* Trust Badges */}
              &lt;div className="pt-8 border-t border-slate-800 grid grid-cols-3 gap-4 text-slate-300 text-xs sm:text-sm"&gt;
                &lt;div className="flex items-center gap-2"&gt;
                  &lt;CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" /&gt;
                  &lt;span&gt;24/7 Online Access&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex items-center gap-2"&gt;
                  &lt;CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" /&gt;
                  &lt;span&gt;Instant Conflict Check&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex items-center gap-2"&gt;
                  &lt;CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" /&gt;
                  &lt;span&gt;Role-Based Security&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Right Quick-Demo Sandbox Card */}
            &lt;div className="lg:col-span-5"&gt;
              &lt;div className="bg-slate-800/90 backdrop-blur-xl border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/50"&gt;
                &lt;div className="flex items-center justify-between pb-4 border-b border-slate-700"&gt;
                  &lt;div className="flex items-center gap-2 text-white font-bold text-base"&gt;
                    &lt;Lock className="w-4 h-4 text-teal-400" /&gt;
                    &lt;span&gt;Quick Interactive Demo Access&lt;/span&gt;
                  &lt;/div&gt;
                  &lt;span className="text-[10px] font-mono px-2 py-0.5 rounded bg-teal-500/20 text-teal-300 border border-teal-500/30"&gt;
                    One-Click Testing
                  &lt;/span&gt;
                &lt;/div&gt;

                &lt;p className="text-xs text-slate-400 my-4"&gt;
                  Experience full role-based workflows directly. Click any role below to instantly authenticate and evaluate the system:
                &lt;/p&gt;

                &lt;div className="space-y-3"&gt;
                  {/* Admin Demo Button */}
                  &lt;button
                    onClick={() =&gt; handleDemoLogin('admin')}
                    className="w-full flex items-center justify-between p-3.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 border border-purple-800/60 transition-all text-left group"
                  &gt;
                    &lt;div className="flex items-center gap-3"&gt;
                      &lt;div className="w-9 h-9 rounded-lg bg-purple-600/30 text-purple-300 flex items-center justify-center font-bold"&gt;
                        &lt;ShieldCheck className="w-5 h-5" /&gt;
                      &lt;/div&gt;
                      &lt;div&gt;
                        &lt;div className="text-sm font-semibold text-purple-200 group-hover:text-white"&gt;
                          Administrator / Receptionist
                        &lt;/div&gt;
                        &lt;div className="text-[11px] text-slate-400"&gt;
                          Doctor CRUD by specialty, master scheduler, reports
                        &lt;/div&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;ChevronRight className="w-4 h-4 text-purple-400 group-hover:translate-x-1 transition-transform" /&gt;
                  &lt;/button&gt;

                  {/* Doctor Demo Button */}
                  &lt;button
                    onClick={() =&gt; handleDemoLogin('doctor')}
                    className="w-full flex items-center justify-between p-3.5 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/60 border border-emerald-800/60 transition-all text-left group"
                  &gt;
                    &lt;div className="flex items-center gap-3"&gt;
                      &lt;div className="w-9 h-9 rounded-lg bg-emerald-600/30 text-emerald-300 flex items-center justify-center font-bold"&gt;
                        &lt;Stethoscope className="w-5 h-5" /&gt;
                      &lt;/div&gt;
                      &lt;div&gt;
                        &lt;div className="text-sm font-semibold text-emerald-200 group-hover:text-white"&gt;
                          Specialist Doctor (Dr. Sarah)
                        &lt;/div&gt;
                        &lt;div className="text-[11px] text-slate-400"&gt;
                          Consultations, prescription writer, surgery approval
                        &lt;/div&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;ChevronRight className="w-4 h-4 text-emerald-400 group-hover:translate-x-1 transition-transform" /&gt;
                  &lt;/button&gt;

                  {/* Patient Demo Button */}
                  &lt;button
                    onClick={() =&gt; handleDemoLogin('patient')}
                    className="w-full flex items-center justify-between p-3.5 rounded-xl bg-teal-950/40 hover:bg-teal-900/60 border border-teal-800/60 transition-all text-left group"
                  &gt;
                    &lt;div className="flex items-center gap-3"&gt;
                      &lt;div className="w-9 h-9 rounded-lg bg-teal-600/30 text-teal-300 flex items-center justify-center font-bold"&gt;
                        &lt;Users className="w-5 h-5" /&gt;
                      &lt;/div&gt;
                      &lt;div&gt;
                        &lt;div className="text-sm font-semibold text-teal-200 group-hover:text-white"&gt;
                          Patient (Michael Davis)
                        &lt;/div&gt;
                        &lt;div className="text-[11px] text-slate-400"&gt;
                          Browse doctors, book slots, view status &amp; alerts
                        &lt;/div&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;ChevronRight className="w-4 h-4 text-teal-400 group-hover:translate-x-1 transition-transform" /&gt;
                  &lt;/button&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/section&gt;

      {/* Specialties Overview */}
      &lt;section className="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20"&gt;
        &lt;div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"&gt;
          {specialties.map((spec) =&gt; {
            const Icon = spec.icon;
            return (
              &lt;div
                key={spec.id}
                onClick={() =&gt; setSelectedSpec(spec.id)}
                className={`p-6 rounded-2xl bg-white border cursor-pointer transition-all transform hover:-translate-y-1 shadow-sm hover:shadow-md ${
                  selectedSpec === spec.id ? 'ring-2 ring-teal-500 border-teal-500' : 'border-slate-200'
                }`}
              &gt;
                &lt;div className={`w-12 h-12 rounded-xl bg-gradient-to-br ${spec.color} text-white flex items-center justify-center mb-4 shadow-md`}&gt;
                  &lt;Icon className="w-6 h-6" /&gt;
                &lt;/div&gt;
                &lt;span className="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 mb-2 inline-block"&gt;
                  {spec.badge}
                &lt;/span&gt;
                &lt;h3 className="text-lg font-bold text-slate-900 mb-1"&gt;{spec.name}&lt;/h3&gt;
                &lt;p className="text-xs text-slate-500 leading-relaxed"&gt;{spec.desc}&lt;/p&gt;
              &lt;/div&gt;
            );
          })}
        &lt;/div&gt;
      &lt;/section&gt;

      {/* Featured Doctors Directory */}
      &lt;section className="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"&gt;
        &lt;div className="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4"&gt;
          &lt;div&gt;
            &lt;span className="text-xs font-bold text-teal-600 uppercase tracking-wider"&gt;Clinical Faculty&lt;/span&gt;
            &lt;h2 className="text-2xl sm:text-3xl font-bold text-slate-900 mt-1"&gt;Available Medical Specialists&lt;/h2&gt;
            &lt;p className="text-sm text-slate-600 mt-1"&gt;Verified consultants ready for in-clinic and surgical consultations&lt;/p&gt;
          &lt;/div&gt;

          {/* Specialty Filter Buttons */}
          &lt;div className="flex flex-wrap gap-2"&gt;
            {['All', 'Cardiology', 'Neurology', 'Orthopedics', 'Dermatology'].map((cat) =&gt; (
              &lt;button
                key={cat}
                onClick={() =&gt; setSelectedSpec(cat)}
                className={`px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all ${
                  selectedSpec === cat
                    ? 'bg-teal-600 text-white shadow-sm'
                    : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50'
                }`}
              &gt;
                {cat}
              &lt;/button&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;

        {loading ? (
          &lt;div className="text-center py-12 text-slate-400"&gt;Loading specialist directory...&lt;/div&gt;
        ) : (
          &lt;div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"&gt;
            {filteredDoctors.map((doc) =&gt; (
              &lt;div
                key={doc.Doc_id}
                className="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-teal-300 hover:shadow-lg transition-all"
              &gt;
                &lt;div&gt;
                  &lt;div className="flex items-center justify-between mb-3"&gt;
                    &lt;span className="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-100"&gt;
                      {doc.Specialization}
                    &lt;/span&gt;
                    &lt;span className="text-xs text-slate-400 flex items-center gap-1"&gt;
                      &lt;Clock className="w-3.5 h-3.5 text-slate-400" /&gt; {doc.Experience_years || 5}+ yrs exp
                    &lt;/span&gt;
                  &lt;/div&gt;

                  &lt;h3 className="text-base font-bold text-slate-900"&gt;{doc.Name}&lt;/h3&gt;
                  &lt;p className="text-xs text-slate-500 mt-0.5"&gt;{doc.Room_no || 'Consultation Suite'}&lt;/p&gt;

                  &lt;div className="mt-4 pt-3 border-t border-slate-100 space-y-1.5 text-xs text-slate-600"&gt;
                    &lt;div className="flex items-center gap-2"&gt;
                      &lt;Clock className="w-3.5 h-3.5 text-teal-600" /&gt;
                      &lt;span className="truncate"&gt;{doc.Availability}&lt;/span&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                &lt;/div&gt;

                &lt;div className="mt-6 pt-4 border-t border-slate-100"&gt;
                  &lt;Link
                    to={isAuthenticated ? '/patient/dashboard' : '/login'}
                    className="w-full py-2 px-3 rounded-lg bg-teal-50 hover:bg-teal-600 hover:text-white text-teal-700 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors"
                  &gt;
                    &lt;CalendarCheck className="w-4 h-4" /&gt; Book Slot
                  &lt;/Link&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        )}
      &lt;/section&gt;

      {/* DFD Architectural Process Flow Section */}
      &lt;section className="py-16 bg-white border-y border-slate-200"&gt;
        &lt;div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"&gt;
          &lt;div className="text-center max-w-3xl mx-auto mb-12"&gt;
            &lt;span className="text-xs font-bold text-teal-600 uppercase tracking-wider"&gt;System Architecture&lt;/span&gt;
            &lt;h2 className="text-2xl sm:text-3xl font-bold text-slate-900 mt-1"&gt;
              End-to-End Automated Care Coordination
            &lt;/h2&gt;
            &lt;p className="text-sm text-slate-600 mt-2"&gt;
              Engineered according to rigorous Data Flow Diagrams (DFD Levels 0, 1.1, 1.2, 1.3, 2.1, 2.2, 2.3)
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;div className="grid grid-cols-1 md:grid-cols-3 gap-8"&gt;
            &lt;div className="p-6 rounded-2xl bg-slate-50 border border-slate-200"&gt;
              &lt;div className="w-10 h-10 rounded-xl bg-teal-600 text-white font-bold flex items-center justify-center mb-4"&gt;
                1
              &lt;/div&gt;
              &lt;h3 className="font-bold text-slate-900 mb-2"&gt;Patient Search &amp; Slot Validation&lt;/h3&gt;
              &lt;p className="text-xs text-slate-600 leading-relaxed"&gt;
                Patients select category (Cardiology, Neurology, Orthopedics, Dermatology), pick available calendar slots, enter symptoms, and trigger automated duplicate-booking prevention.
              &lt;/p&gt;
            &lt;/div&gt;

            &lt;div className="p-6 rounded-2xl bg-slate-50 border border-slate-200"&gt;
              &lt;div className="w-10 h-10 rounded-xl bg-emerald-600 text-white font-bold flex items-center justify-center mb-4"&gt;
                2
              &lt;/div&gt;
              &lt;h3 className="font-bold text-slate-900 mb-2"&gt;Specialist Disease &amp; Surgery Analysis&lt;/h3&gt;
              &lt;p className="text-xs text-slate-600 leading-relaxed"&gt;
                Specialists access daily consultation queues, analyze patient history &amp; disease symptoms, prescribe treatment medicines, mark 'Seen'/'No-Show', and approve/reject surgery.
              &lt;/p&gt;
            &lt;/div&gt;

            &lt;div className="p-6 rounded-2xl bg-slate-50 border border-slate-200"&gt;
              &lt;div className="w-10 h-10 rounded-xl bg-purple-600 text-white font-bold flex items-center justify-center mb-4"&gt;
                3
              &lt;/div&gt;
              &lt;h3 className="font-bold text-slate-900 mb-2"&gt;Centralized Admin Scheduling &amp; Security&lt;/h3&gt;
              &lt;p className="text-xs text-slate-600 leading-relaxed"&gt;
                Administrators oversee specialist faculty across departments, resolve scheduling conflicts, monitor aggregate analytics reports, and maintain encrypted credentials.
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/section&gt;
    &lt;/div&gt;
  );
};

export default LandingPage;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      27. Multi-Role Unified Login Screen
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/src/pages/LoginPage.jsx</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">8. FRONTEND DASHBOARDS & USER INTERFACES</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Login page with role switcher tabs (Patient / Doctor / Admin), quick demo fill buttons, and form validations.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import {
  HeartPulse,
  Lock,
  Mail,
  UserCheck,
  Stethoscope,
  ShieldCheck,
  AlertCircle,
  ArrowRight,
  Sparkles
} from 'lucide-react';

const LoginPage = () =&gt; {
  const { login, quickDemoLogin } = useAuth();
  const navigate = useNavigate();

  const [activeRole, setActiveRole] = useState('patient');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e) =&gt; {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      const res = await login(email, password, activeRole);
      if (res.success) {
        if (res.user.role === 'admin') navigate('/admin/dashboard');
        else if (res.user.role === 'doctor') navigate('/doctor/dashboard');
        else navigate('/patient/dashboard');
      } else {
        setError(res.message || 'Login failed. Please verify credentials.');
      }
    } catch (err) {
      setError(err.response?.data?.message || 'Invalid email or password.');
    } finally {
      setLoading(false);
    }
  };

  const fillDemo = (role) =&gt; {
    setActiveRole(role);
    if (role === 'patient') {
      setEmail('michael.davis@example.com');
      setPassword('patient123');
    } else if (role === 'doctor') {
      setEmail('cardio.sarah@hospital.org');
      setPassword('doctor123');
    } else if (role === 'admin') {
      setEmail('admin@hospital.org');
      setPassword('admin123');
    }
    setError('');
  };

  return (
    &lt;div className="min-h-screen bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"&gt;
      &lt;div className="max-w-md w-full space-y-8"&gt;
        {/* Header */}
        &lt;div className="text-center"&gt;
          &lt;div className="mx-auto w-14 h-14 rounded-2xl bg-teal-600 flex items-center justify-center text-white shadow-lg shadow-teal-600/30"&gt;
            &lt;HeartPulse className="w-8 h-8" /&gt;
          &lt;/div&gt;
          &lt;h2 className="mt-4 text-3xl font-extrabold text-slate-900 tracking-tight"&gt;
            Sign In to OPAS
          &lt;/h2&gt;
          &lt;p className="mt-1 text-xs text-slate-500"&gt;
            CareConnect Online Patient Appointment System
          &lt;/p&gt;
        &lt;/div&gt;

        {/* Role Switcher Tabs */}
        &lt;div className="bg-slate-200/80 p-1 rounded-xl flex gap-1 shadow-inner"&gt;
          &lt;button
            type="button"
            onClick={() =&gt; {
              setActiveRole('patient');
              setError('');
            }}
            className={`flex-1 py-2 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
              activeRole === 'patient'
                ? 'bg-white text-teal-700 shadow-sm'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          &gt;
            &lt;UserCheck className="w-4 h-4" /&gt; Patient
          &lt;/button&gt;

          &lt;button
            type="button"
            onClick={() =&gt; {
              setActiveRole('doctor');
              setError('');
            }}
            className={`flex-1 py-2 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
              activeRole === 'doctor'
                ? 'bg-white text-emerald-700 shadow-sm'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          &gt;
            &lt;Stethoscope className="w-4 h-4" /&gt; Doctor
          &lt;/button&gt;

          &lt;button
            type="button"
            onClick={() =&gt; {
              setActiveRole('admin');
              setError('');
            }}
            className={`flex-1 py-2 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
              activeRole === 'admin'
                ? 'bg-white text-purple-700 shadow-sm'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          &gt;
            &lt;ShieldCheck className="w-4 h-4" /&gt; Admin
          &lt;/button&gt;
        &lt;/div&gt;

        {/* Card Body */}
        &lt;div className="bg-white py-8 px-6 shadow-xl rounded-2xl border border-slate-200 space-y-6"&gt;
          {error &amp;&amp; (
            &lt;div className="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2"&gt;
              &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
              &lt;span&gt;{error}&lt;/span&gt;
            &lt;/div&gt;
          )}

          {/* Quick Demo Pre-Fill buttons */}
          &lt;div className="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2"&gt;
            &lt;div className="flex items-center justify-between text-[11px] font-semibold text-slate-500"&gt;
              &lt;span className="flex items-center gap-1"&gt;
                &lt;Sparkles className="w-3.5 h-3.5 text-amber-500" /&gt; Fast Fill Demo Credentials
              &lt;/span&gt;
            &lt;/div&gt;
            &lt;div className="grid grid-cols-3 gap-1.5"&gt;
              &lt;button
                type="button"
                onClick={() =&gt; fillDemo('patient')}
                className="py-1 px-2 text-[10px] font-bold bg-teal-50 text-teal-700 hover:bg-teal-100 rounded border border-teal-200 transition-colors truncate"
              &gt;
                Patient
              &lt;/button&gt;
              &lt;button
                type="button"
                onClick={() =&gt; fillDemo('doctor')}
                className="py-1 px-2 text-[10px] font-bold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded border border-emerald-200 transition-colors truncate"
              &gt;
                Dr. Sarah
              &lt;/button&gt;
              &lt;button
                type="button"
                onClick={() =&gt; fillDemo('admin')}
                className="py-1 px-2 text-[10px] font-bold bg-purple-50 text-purple-700 hover:bg-purple-100 rounded border border-purple-200 transition-colors truncate"
              &gt;
                Admin
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;form onSubmit={handleSubmit} className="space-y-4"&gt;
            &lt;div&gt;
              &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;Email Address&lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;Mail className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                &lt;input
                  type="email"
                  required
                  value={email}
                  onChange={(e) =&gt; setEmail(e.target.value)}
                  placeholder={
                    activeRole === 'admin'
                      ? 'admin@hospital.org'
                      : activeRole === 'doctor'
                      ? 'doctor@hospital.org'
                      : 'patient@example.com'
                  }
                  className="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none transition-all"
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div&gt;
              &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;Password&lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;Lock className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                &lt;input
                  type="password"
                  required
                  value={password}
                  onChange={(e) =&gt; setPassword(e.target.value)}
                  placeholder="••••••••"
                  className="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none transition-all"
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;button
              type="submit"
              disabled={loading}
              className={`w-full py-3 px-4 rounded-xl text-white font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 ${
                activeRole === 'admin'
                  ? 'bg-purple-600 hover:bg-purple-700 shadow-purple-600/20'
                  : activeRole === 'doctor'
                  ? 'bg-emerald-600 hover:bg-emerald-700 shadow-emerald-600/20'
                  : 'bg-teal-600 hover:bg-teal-700 shadow-teal-600/20'
              } ${loading ? 'opacity-70 cursor-not-allowed' : ''}`}
            &gt;
              {loading ? 'Authenticating...' : `Sign In as ${activeRole.charAt(0).toUpperCase() + activeRole.slice(1)}`}
              {!loading &amp;&amp; &lt;ArrowRight className="w-4 h-4" /&gt;}
            &lt;/button&gt;
          &lt;/form&gt;

          {activeRole === 'patient' &amp;&amp; (
            &lt;div className="text-center pt-2 border-t border-slate-100"&gt;
              &lt;p className="text-xs text-slate-600"&gt;
                New to CareConnect?{' '}
                &lt;Link to="/register" className="text-teal-600 font-bold hover:underline"&gt;
                  Create a Patient Account
                &lt;/Link&gt;
              &lt;/p&gt;
            &lt;/div&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

export default LoginPage;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      28. Patient Registration Screen
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/src/pages/RegisterPage.jsx</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">8. FRONTEND DASHBOARDS & USER INTERFACES</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>User registration form capturing Name, Age, Phone, Email, Place, Address, and Password with instant account creation.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import {
  HeartPulse,
  User,
  Phone,
  Mail,
  MapPin,
  Lock,
  Calendar,
  AlertCircle,
  CheckCircle2,
  ArrowRight
} from 'lucide-react';

const RegisterPage = () =&gt; {
  const { register } = useAuth();
  const navigate = useNavigate();

  const [formData, setFormData] = useState({
    name: '',
    age: '',
    phone: '',
    email: '',
    place: '',
    address: '',
    password: '',
    confirmPassword: ''
  });

  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const handleChange = (e) =&gt; {
    setFormData(prev =&gt; ({
      ...prev,
      [e.target.name]: e.target.value
    }));
  };

  const handleSubmit = async (e) =&gt; {
    e.preventDefault();
    setError('');

    if (formData.password !== formData.confirmPassword) {
      return setError('Passwords do not match.');
    }

    if (formData.password.length &lt; 6) {
      return setError('Password must be at least 6 characters long.');
    }

    if (parseInt(formData.age, 10) &lt; 1 || parseInt(formData.age, 10) &gt; 120) {
      return setError('Please enter a valid age between 1 and 120.');
    }

    setLoading(true);

    try {
      const res = await register({
        name: formData.name,
        age: parseInt(formData.age, 10),
        phone: formData.phone,
        email: formData.email,
        place: formData.place,
        address: formData.address,
        password: formData.password
      });

      if (res.success) {
        navigate('/patient/dashboard');
      } else {
        setError(res.message || 'Registration failed.');
      }
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to register account.');
    } finally {
      setLoading(false);
    }
  };

  return (
    &lt;div className="min-h-screen bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"&gt;
      &lt;div className="max-w-xl w-full space-y-8"&gt;
        &lt;div className="text-center"&gt;
          &lt;div className="mx-auto w-14 h-14 rounded-2xl bg-teal-600 flex items-center justify-center text-white shadow-lg shadow-teal-600/30"&gt;
            &lt;HeartPulse className="w-8 h-8" /&gt;
          &lt;/div&gt;
          &lt;h2 className="mt-4 text-3xl font-extrabold text-slate-900 tracking-tight"&gt;
            Patient Registration
          &lt;/h2&gt;
          &lt;p className="mt-1 text-xs text-slate-500"&gt;
            Create your patient portal profile for 24/7 online doctor appointments
          &lt;/p&gt;
        &lt;/div&gt;

        &lt;div className="bg-white py-8 px-6 sm:px-10 shadow-xl rounded-2xl border border-slate-200"&gt;
          {error &amp;&amp; (
            &lt;div className="mb-6 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2"&gt;
              &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
              &lt;span&gt;{error}&lt;/span&gt;
            &lt;/div&gt;
          )}

          &lt;form onSubmit={handleSubmit} className="space-y-4"&gt;
            &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-4"&gt;
              {/* Full Name */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Full Name &lt;span className="text-rose-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;User className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="text"
                    name="name"
                    required
                    value={formData.name}
                    onChange={handleChange}
                    placeholder="e.g. John Doe"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Age */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Age &lt;span className="text-rose-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;input
                  type="number"
                  name="age"
                  required
                  min="1"
                  max="120"
                  value={formData.age}
                  onChange={handleChange}
                  placeholder="e.g. 34"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-4"&gt;
              {/* Phone */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Phone Number &lt;span className="text-rose-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;Phone className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="tel"
                    name="phone"
                    required
                    value={formData.phone}
                    onChange={handleChange}
                    placeholder="e.g. +1 555-0192"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Email */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;Email Address&lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;Mail className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="email"
                    name="email"
                    value={formData.email}
                    onChange={handleChange}
                    placeholder="e.g. patient@example.com"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-4"&gt;
              {/* Place */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;City / Place&lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;MapPin className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="text"
                    name="place"
                    value={formData.place}
                    onChange={handleChange}
                    placeholder="e.g. Nilambur"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Address */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;Residential Address&lt;/label&gt;
                &lt;input
                  type="text"
                  name="address"
                  value={formData.address}
                  onChange={handleChange}
                  placeholder="e.g. 12 Meadow St, Apt 4"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2"&gt;
              {/* Password */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Password &lt;span className="text-rose-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;Lock className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="password"
                    name="password"
                    required
                    value={formData.password}
                    onChange={handleChange}
                    placeholder="Min 6 characters"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Confirm Password */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Confirm Password &lt;span className="text-rose-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;Lock className="w-4 h-4 text-slate-400 absolute left-3 top-3" /&gt;
                  &lt;input
                    type="password"
                    name="confirmPassword"
                    required
                    value={formData.confirmPassword}
                    onChange={handleChange}
                    placeholder="Repeat password"
                    className="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="pt-4"&gt;
              &lt;button
                type="submit"
                disabled={loading}
                className="w-full py-3 px-4 rounded-xl text-white font-bold text-sm bg-teal-600 hover:bg-teal-700 shadow-md shadow-teal-600/20 transition-all flex items-center justify-center gap-2"
              &gt;
                {loading ? 'Creating Account...' : 'Complete Registration'}
                {!loading &amp;&amp; &lt;ArrowRight className="w-4 h-4" /&gt;}
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/form&gt;

          &lt;div className="text-center pt-6 mt-6 border-t border-slate-100"&gt;
            &lt;p className="text-xs text-slate-600"&gt;
              Already have an account?{' '}
              &lt;Link to="/login" className="text-teal-600 font-bold hover:underline"&gt;
                Sign In
              &lt;/Link&gt;
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

export default RegisterPage;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      29. Patient Portal Dashboard
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/src/pages/patient/PatientDashboard.jsx</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">8. FRONTEND DASHBOARDS & USER INTERFACES</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Full patient portal: specialist browsing, dynamic calendar slot selector with conflict avoidance, appointment tracking, rescheduling, cancellation modal, and prescription/doctor notes viewer.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState, useEffect } from 'react';
import { useAuth } from '../../context/AuthContext';
import api from '../../services/api';
import {
  Calendar,
  Clock,
  User,
  HeartPulse,
  Brain,
  Bone,
  Sparkles,
  Search,
  CheckCircle2,
  XCircle,
  AlertTriangle,
  FileText,
  Bell,
  RefreshCw,
  PlusCircle,
  Filter,
  Phone,
  MapPin,
  Stethoscope,
  Activity,
  X,
  ChevronRight
} from 'lucide-react';

const PatientDashboard = () =&gt; {
  const { user } = useAuth();

  const [doctors, setDoctors] = useState([]);
  const [appointments, setAppointments] = useState([]);
  const [notifications, setNotifications] = useState([]);
  const [selectedSpecialty, setSelectedSpecialty] = useState('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState('appointments'); // 'appointments' | 'doctors' | 'notifications'

  // Booking Modal State
  const [isBookModalOpen, setIsBookModalOpen] = useState(false);
  const [selectedDoc, setSelectedDoc] = useState(null);
  const [bookDate, setBookDate] = useState(new Date().toISOString().split('T')[0]);
  const [availableSlots, setAvailableSlots] = useState([]);
  const [selectedSlot, setSelectedSlot] = useState('');
  const [symptoms, setSymptoms] = useState('');
  const [disease, setDisease] = useState('');
  const [bookingLoading, setBookingLoading] = useState(false);
  const [bookingError, setBookingError] = useState('');
  const [bookingSuccess, setBookingSuccess] = useState('');

  // Reschedule Modal State
  const [rescheduleModalOpen, setRescheduleModalOpen] = useState(false);
  const [appoToReschedule, setAppoToReschedule] = useState(null);
  const [newDate, setNewDate] = useState('');
  const [newSlots, setNewSlots] = useState([]);
  const [newSlot, setNewSlot] = useState('');
  const [rescheduleLoading, setRescheduleLoading] = useState(false);
  const [rescheduleError, setRescheduleError] = useState('');

  // Prescription View Modal State
  const [viewPrescriptionModal, setViewPrescriptionModal] = useState(false);
  const [activePrescriptionAppo, setActivePrescriptionAppo] = useState(null);

  useEffect(() =&gt; {
    fetchDashboardData();
  }, []);

  const fetchDashboardData = async () =&gt; {
    setLoading(true);
    try {
      const [docRes, appRes, notRes] = await Promise.all([
        api.get('/patient/doctors'),
        api.get('/patient/appointments'),
        api.get('/patient/notifications')
      ]);

      if (docRes.data.success) setDoctors(docRes.data.doctors || []);
      if (appRes.data.success) setAppointments(appRes.data.appointments || []);
      if (notRes.data.success) setNotifications(notRes.data.notifications || []);
    } catch (err) {
      console.error('Failed to load dashboard data:', err);
    } finally {
      setLoading(false);
    }
  };

  // Fetch Available Slots for Doctor on date change
  const fetchSlotsForDoc = async (docId, date) =&gt; {
    try {
      const res = await api.get(`/patient/doctors/${docId}/slots?date=${date}`);
      if (res.data.success) {
        setAvailableSlots(res.data.slots || []);
        // select first available
        const firstAvail = res.data.slots.find(s =&gt; s.available);
        setSelectedSlot(firstAvail ? firstAvail.time : '');
      }
    } catch (err) {
      console.error(err);
    }
  };

  const openBookModal = (doc) =&gt; {
    setSelectedDoc(doc);
    const today = new Date().toISOString().split('T')[0];
    setBookDate(today);
    setSymptoms('');
    setDisease('');
    setBookingError('');
    setBookingSuccess('');
    setIsBookModalOpen(true);
    fetchSlotsForDoc(doc.Doc_id, today);
  };

  const handleBookDateChange = (date) =&gt; {
    setBookDate(date);
    if (selectedDoc) {
      fetchSlotsForDoc(selectedDoc.Doc_id, date);
    }
  };

  const handleBookSubmit = async (e) =&gt; {
    e.preventDefault();
    setBookingError('');
    setBookingSuccess('');

    if (!selectedSlot) {
      setBookingError('Please select an available time slot.');
      return;
    }

    setBookingLoading(true);
    try {
      const res = await api.post('/patient/appointments', {
        doc_id: selectedDoc.Doc_id,
        appo_date: bookDate,
        appo_time: selectedSlot,
        symptoms,
        disease
      });

      if (res.data.success) {
        setBookingSuccess('Appointment confirmed successfully!');
        setTimeout(() =&gt; {
          setIsBookModalOpen(false);
          fetchDashboardData();
          setActiveTab('appointments');
        }, 1200);
      }
    } catch (err) {
      setBookingError(err.response?.data?.message || 'Failed to book appointment.');
    } finally {
      setBookingLoading(false);
    }
  };

  // Cancel Appointment
  const handleCancelAppointment = async (appoId) =&gt; {
    if (!window.confirm('Are you sure you want to cancel this appointment?')) return;
    try {
      const res = await api.put(`/patient/appointments/${appoId}/cancel`);
      if (res.data.success) {
        fetchDashboardData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to cancel appointment.');
    }
  };

  // Open Reschedule Modal
  const openRescheduleModal = async (appo) =&gt; {
    setAppoToReschedule(appo);
    setNewDate(appo.Appo_date);
    setRescheduleError('');
    setRescheduleModalOpen(true);

    try {
      const res = await api.get(`/patient/doctors/${appo.Doc_id}/slots?date=${appo.Appo_date}`);
      if (res.data.success) {
        setNewSlots(res.data.slots || []);
        setNewSlot(appo.Appo_time);
      }
    } catch (e) {}
  };

  const handleRescheduleDateChange = async (date) =&gt; {
    setNewDate(date);
    if (appoToReschedule) {
      try {
        const res = await api.get(`/patient/doctors/${appoToReschedule.Doc_id}/slots?date=${date}`);
        if (res.data.success) {
          setNewSlots(res.data.slots || []);
          const first = res.data.slots.find(s =&gt; s.available);
          setNewSlot(first ? first.time : '');
        }
      } catch (e) {}
    }
  };

  const handleRescheduleSubmit = async (e) =&gt; {
    e.preventDefault();
    if (!newSlot) {
      setRescheduleError('Please select an available time slot.');
      return;
    }

    setRescheduleLoading(true);
    setRescheduleError('');

    try {
      const res = await api.put(`/patient/appointments/${appoToReschedule.Appo_id}/reschedule`, {
        new_date: newDate,
        new_time: newSlot
      });

      if (res.data.success) {
        setRescheduleModalOpen(false);
        fetchDashboardData();
      }
    } catch (err) {
      setRescheduleError(err.response?.data?.message || 'Failed to reschedule.');
    } finally {
      setRescheduleLoading(false);
    }
  };

  const getStatusBadge = (status) =&gt; {
    switch (status) {
      case 'Confirmed':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200"&gt;
            &lt;CheckCircle2 className="w-3.5 h-3.5 text-blue-600" /&gt; Confirmed
          &lt;/span&gt;
        );
      case 'Seen':
      case 'Completed':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200"&gt;
            &lt;CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" /&gt; {status}
          &lt;/span&gt;
        );
      case 'Approved for Surgery':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200"&gt;
            &lt;Activity className="w-3.5 h-3.5 text-purple-600" /&gt; Surgery Approved
          &lt;/span&gt;
        );
      case 'Rejected for Surgery':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200"&gt;
            &lt;AlertTriangle className="w-3.5 h-3.5 text-amber-600" /&gt; Non-Surgical
          &lt;/span&gt;
        );
      case 'Cancelled':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200"&gt;
            &lt;XCircle className="w-3.5 h-3.5 text-rose-600" /&gt; Cancelled
          &lt;/span&gt;
        );
      default:
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200"&gt;
            &lt;Clock className="w-3.5 h-3.5 text-amber-600" /&gt; Pending
          &lt;/span&gt;
        );
    }
  };

  const filteredDoctors = doctors.filter((doc) =&gt; {
    const matchesSpec = selectedSpecialty === 'All' || doc.Specialization.toLowerCase() === selectedSpecialty.toLowerCase();
    const matchesSearch = doc.Name.toLowerCase().includes(searchQuery.toLowerCase()) || doc.Specialization.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesSpec &amp;&amp; matchesSearch;
  });

  const upcomingCount = appointments.filter(a =&gt; a.Status === 'Confirmed' || a.Status === 'Pending').length;
  const completedCount = appointments.filter(a =&gt; a.Status === 'Completed' || a.Status === 'Seen' || a.Status === 'Approved for Surgery').length;

  return (
    &lt;div className="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8"&gt;
      &lt;div className="max-w-7xl mx-auto space-y-8"&gt;
        {/* Welcome Header */}
        &lt;div className="bg-gradient-to-r from-teal-700 via-teal-800 to-cyan-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6"&gt;
          &lt;div className="space-y-2"&gt;
            &lt;div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-500/30 text-teal-200 text-xs font-semibold backdrop-blur-xs"&gt;
              &lt;User className="w-3.5 h-3.5" /&gt; Patient Portal
            &lt;/div&gt;
            &lt;h1 className="text-2xl sm:text-3xl font-extrabold tracking-tight"&gt;
              Welcome, {user?.name}
            &lt;/h1&gt;
            &lt;p className="text-xs sm:text-sm text-teal-100 max-w-xl"&gt;
              Manage your doctor consultations, track appointment status, view medical prescriptions, and receive clinical alerts.
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;div className="flex flex-wrap gap-3"&gt;
            &lt;button
              onClick={() =&gt; setActiveTab('doctors')}
              className="px-4 py-2.5 rounded-xl bg-white text-teal-900 font-bold text-xs shadow-md hover:bg-teal-50 transition-all flex items-center gap-2"
            &gt;
              &lt;PlusCircle className="w-4 h-4 text-teal-600" /&gt; Book New Appointment
            &lt;/button&gt;
            &lt;button
              onClick={fetchDashboardData}
              className="p-2.5 rounded-xl bg-teal-800/80 hover:bg-teal-700/80 text-white transition-colors"
              title="Refresh Data"
            &gt;
              &lt;RefreshCw className="w-4 h-4" /&gt;
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Stats Strip */}
        &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-4"&gt;
          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold"&gt;
              &lt;Calendar className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Upcoming Bookings&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{upcomingCount}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold"&gt;
              &lt;CheckCircle2 className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Completed Visits&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{completedCount}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold"&gt;
              &lt;Bell className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Alerts &amp; Updates&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{notifications.length}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Navigation Tabs */}
        &lt;div className="border-b border-slate-200 flex gap-4"&gt;
          &lt;button
            onClick={() =&gt; setActiveTab('appointments')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'appointments'
                ? 'border-teal-600 text-teal-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Calendar className="w-4 h-4" /&gt; My Appointments ({appointments.length})
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('doctors')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'doctors'
                ? 'border-teal-600 text-teal-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Stethoscope className="w-4 h-4" /&gt; Find Specialists ({doctors.length})
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('notifications')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'notifications'
                ? 'border-teal-600 text-teal-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Bell className="w-4 h-4" /&gt; Notifications ({notifications.length})
          &lt;/button&gt;
        &lt;/div&gt;

        {/* TAB 1: MY APPOINTMENTS */}
        {activeTab === 'appointments' &amp;&amp; (
          &lt;div className="space-y-4"&gt;
            {loading ? (
              &lt;div className="text-center py-12 text-slate-400"&gt;Loading appointments...&lt;/div&gt;
            ) : appointments.length === 0 ? (
              &lt;div className="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-4"&gt;
                &lt;div className="w-16 h-16 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center mx-auto"&gt;
                  &lt;Calendar className="w-8 h-8" /&gt;
                &lt;/div&gt;
                &lt;h3 className="text-lg font-bold text-slate-900"&gt;No Appointments Booked&lt;/h3&gt;
                &lt;p className="text-xs text-slate-500 max-w-sm mx-auto"&gt;
                  You haven't scheduled any doctor appointments yet. Browse our specialist faculty to schedule your consultation.
                &lt;/p&gt;
                &lt;button
                  onClick={() =&gt; setActiveTab('doctors')}
                  className="px-4 py-2 rounded-xl bg-teal-600 text-white text-xs font-bold shadow-sm hover:bg-teal-700"
                &gt;
                  Browse Doctors Now
                &lt;/button&gt;
              &lt;/div&gt;
            ) : (
              &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;
                {appointments.map((appo) =&gt; (
                  &lt;div
                    key={appo.Appo_id}
                    className="bg-white rounded-2xl border border-slate-200 p-5 space-y-4 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between"
                  &gt;
                    &lt;div&gt;
                      &lt;div className="flex items-start justify-between gap-2 mb-2"&gt;
                        &lt;div&gt;
                          &lt;span className="text-[11px] font-semibold text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-100"&gt;
                            {appo.Specialization}
                          &lt;/span&gt;
                          &lt;h3 className="text-base font-bold text-slate-900 mt-1"&gt;
                            {appo.Doctor_name}
                          &lt;/h3&gt;
                          &lt;p className="text-xs text-slate-500"&gt;{appo.Room_no || 'Consultation Suite'}&lt;/p&gt;
                        &lt;/div&gt;
                        &lt;div&gt;{getStatusBadge(appo.Status)}&lt;/div&gt;
                      &lt;/div&gt;

                      &lt;div className="grid grid-cols-2 gap-2 my-3 py-2 border-y border-slate-100 text-xs text-slate-700"&gt;
                        &lt;div className="flex items-center gap-1.5"&gt;
                          &lt;Calendar className="w-3.5 h-3.5 text-teal-600 shrink-0" /&gt;
                          &lt;span className="font-semibold"&gt;{appo.Appo_date}&lt;/span&gt;
                        &lt;/div&gt;
                        &lt;div className="flex items-center gap-1.5"&gt;
                          &lt;Clock className="w-3.5 h-3.5 text-teal-600 shrink-0" /&gt;
                          &lt;span className="font-semibold"&gt;{appo.Appo_time?.slice(0, 5)}&lt;/span&gt;
                        &lt;/div&gt;
                      &lt;/div&gt;

                      {appo.Symptoms &amp;&amp; (
                        &lt;div className="text-xs text-slate-600 space-y-1"&gt;
                          &lt;span className="font-semibold text-slate-800"&gt;Reported Symptoms:&lt;/span&gt;
                          &lt;p className="text-slate-600 italic bg-slate-50 p-2 rounded-lg border border-slate-100"&gt;
                            "{appo.Symptoms}"
                          &lt;/p&gt;
                        &lt;/div&gt;
                      )}

                      {appo.Disease &amp;&amp; (
                        &lt;div className="mt-2 text-xs"&gt;
                          &lt;span className="font-semibold text-slate-800"&gt;Evaluated Condition:&lt;/span&gt;{' '}
                          &lt;span className="text-teal-700 font-medium"&gt;{appo.Disease}&lt;/span&gt;
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;

                    &lt;div className="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2"&gt;
                      &lt;div className="flex items-center gap-2"&gt;
                        {appo.Prescription &amp;&amp; (
                          &lt;button
                            onClick={() =&gt; {
                              setActivePrescriptionAppo(appo);
                              setViewPrescriptionModal(true);
                            }}
                            className="px-2.5 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 text-xs font-bold flex items-center gap-1 border border-emerald-200"
                          &gt;
                            &lt;FileText className="w-3.5 h-3.5" /&gt; View Rx &amp; Notes
                          &lt;/button&gt;
                        )}
                      &lt;/div&gt;

                      {appo.Status !== 'Cancelled' &amp;&amp; appo.Status !== 'Completed' &amp;&amp; (
                        &lt;div className="flex items-center gap-2"&gt;
                          &lt;button
                            onClick={() =&gt; openRescheduleModal(appo)}
                            className="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1"
                          &gt;
                            &lt;RefreshCw className="w-3 h-3" /&gt; Reschedule
                          &lt;/button&gt;
                          &lt;button
                            onClick={() =&gt; handleCancelAppointment(appo.Appo_id)}
                            className="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold flex items-center gap-1 border border-rose-200"
                          &gt;
                            &lt;XCircle className="w-3 h-3" /&gt; Cancel
                          &lt;/button&gt;
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;
                  &lt;/div&gt;
                ))}
              &lt;/div&gt;
            )}
          &lt;/div&gt;
        )}

        {/* TAB 2: FIND DOCTORS */}
        {activeTab === 'doctors' &amp;&amp; (
          &lt;div className="space-y-6"&gt;
            {/* Filter controls */}
            &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row gap-4 justify-between items-center"&gt;
              &lt;div className="flex flex-wrap gap-2 w-full md:w-auto"&gt;
                {['All', 'Cardiology', 'Neurology', 'Orthopedics', 'Dermatology'].map((cat) =&gt; (
                  &lt;button
                    key={cat}
                    onClick={() =&gt; setSelectedSpecialty(cat)}
                    className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all ${
                      selectedSpecialty === cat
                        ? 'bg-teal-600 text-white shadow-xs'
                        : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                    }`}
                  &gt;
                    {cat}
                  &lt;/button&gt;
                ))}
              &lt;/div&gt;

              &lt;div className="relative w-full md:w-72"&gt;
                &lt;Search className="w-4 h-4 text-slate-400 absolute left-3 top-2.5" /&gt;
                &lt;input
                  type="text"
                  placeholder="Search doctor or clinic..."
                  value={searchQuery}
                  onChange={(e) =&gt; setSearchQuery(e.target.value)}
                  className="w-full pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 text-xs outline-none focus:ring-2 focus:ring-teal-500"
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Doctor Grid */}
            &lt;div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"&gt;
              {filteredDoctors.map((doc) =&gt; (
                &lt;div
                  key={doc.Doc_id}
                  className="bg-white rounded-2xl border border-slate-200 p-5 flex flex-col justify-between hover:shadow-md hover:border-teal-300 transition-all"
                &gt;
                  &lt;div className="space-y-3"&gt;
                    &lt;div className="flex items-center justify-between"&gt;
                      &lt;span className="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-100"&gt;
                        {doc.Specialization}
                      &lt;/span&gt;
                      &lt;span className="text-[11px] text-slate-400"&gt;{doc.Experience_years || 5}+ Yrs Exp&lt;/span&gt;
                    &lt;/div&gt;

                    &lt;div&gt;
                      &lt;h3 className="text-base font-bold text-slate-900"&gt;{doc.Name}&lt;/h3&gt;
                      &lt;p className="text-xs text-slate-500 flex items-center gap-1 mt-0.5"&gt;
                        &lt;MapPin className="w-3 h-3 text-slate-400" /&gt; {doc.Room_no || 'Consultation Suite'}
                      &lt;/p&gt;
                    &lt;/div&gt;

                    &lt;div className="p-2.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1 text-xs text-slate-600"&gt;
                      &lt;div className="flex items-center gap-1.5 font-medium text-slate-700"&gt;
                        &lt;Clock className="w-3.5 h-3.5 text-teal-600" /&gt;
                        &lt;span&gt;{doc.Availability}&lt;/span&gt;
                      &lt;/div&gt;
                      {doc.Phone &amp;&amp; (
                        &lt;div className="flex items-center gap-1.5 text-slate-500 text-[11px]"&gt;
                          &lt;Phone className="w-3 h-3 text-slate-400" /&gt;
                          &lt;span&gt;{doc.Phone}&lt;/span&gt;
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;
                  &lt;/div&gt;

                  &lt;div className="mt-6 pt-3 border-t border-slate-100"&gt;
                    &lt;button
                      onClick={() =&gt; openBookModal(doc)}
                      className="w-full py-2 px-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold flex items-center justify-center gap-1.5 shadow-sm shadow-teal-600/20 transition-all"
                    &gt;
                      &lt;Calendar className="w-4 h-4" /&gt; Book Appointment
                    &lt;/button&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              ))}
            &lt;/div&gt;
          &lt;/div&gt;
        )}

        {/* TAB 3: NOTIFICATIONS */}
        {activeTab === 'notifications' &amp;&amp; (
          &lt;div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;h3 className="font-bold text-slate-900 text-base flex items-center gap-2"&gt;
                &lt;Bell className="w-5 h-5 text-teal-600" /&gt; Automated Clinical Notifications
              &lt;/h3&gt;
              &lt;span className="text-xs text-slate-400"&gt;{notifications.length} alerts received&lt;/span&gt;
            &lt;/div&gt;

            {notifications.length === 0 ? (
              &lt;div className="py-8 text-center text-slate-400 text-xs"&gt;No notifications found.&lt;/div&gt;
            ) : (
              &lt;div className="divide-y divide-slate-100"&gt;
                {notifications.map((n) =&gt; (
                  &lt;div key={n.Not_id} className="py-3.5 flex items-start gap-3"&gt;
                    &lt;div className="w-8 h-8 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 mt-0.5"&gt;
                      &lt;CheckCircle2 className="w-4 h-4" /&gt;
                    &lt;/div&gt;
                    &lt;div className="flex-1"&gt;
                      &lt;p className="text-xs sm:text-sm font-medium text-slate-800"&gt;{n.Msg}&lt;/p&gt;
                      &lt;div className="flex items-center gap-3 text-[11px] text-slate-400 mt-1"&gt;
                        &lt;span&gt;Date: {n.Date}&lt;/span&gt;
                        &lt;span&gt;Time: {n.Time?.slice(0, 5)}&lt;/span&gt;
                        {n.Doctor_name &amp;&amp; &lt;span&gt;Doctor: {n.Doctor_name} ({n.Specialization})&lt;/span&gt;}
                      &lt;/div&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                ))}
              &lt;/div&gt;
            )}
          &lt;/div&gt;
        )}
      &lt;/div&gt;

      {/* ----------------- BOOKING MODAL ----------------- */}
      {isBookModalOpen &amp;&amp; selectedDoc &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in zoom-in-95 max-h-[90vh] overflow-y-auto"&gt;
            &lt;div className="flex items-center justify-between pb-4 border-b border-slate-100"&gt;
              &lt;div&gt;
                &lt;span className="text-[11px] font-bold text-teal-700 bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-100"&gt;
                  {selectedDoc.Specialization}
                &lt;/span&gt;
                &lt;h3 className="text-lg font-bold text-slate-900 mt-1"&gt;
                  Book Slot with {selectedDoc.Name}
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button
                onClick={() =&gt; setIsBookModalOpen(false)}
                className="p-1.5 rounded-full hover:bg-slate-100 text-slate-400"
              &gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {bookingError &amp;&amp; (
              &lt;div className="mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2"&gt;
                &lt;AlertTriangle className="w-4 h-4 shrink-0" /&gt;
                &lt;span&gt;{bookingError}&lt;/span&gt;
              &lt;/div&gt;
            )}

            {bookingSuccess &amp;&amp; (
              &lt;div className="mt-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2"&gt;
                &lt;CheckCircle2 className="w-4 h-4 shrink-0" /&gt;
                &lt;span&gt;{bookingSuccess}&lt;/span&gt;
              &lt;/div&gt;
            )}

            &lt;form onSubmit={handleBookSubmit} className="mt-4 space-y-4"&gt;
              {/* Date Selector */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Select Consultation Date
                &lt;/label&gt;
                &lt;input
                  type="date"
                  required
                  min={new Date().toISOString().split('T')[0]}
                  value={bookDate}
                  onChange={(e) =&gt; handleBookDateChange(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;

              {/* Time Slots Selector */}
              &lt;div&gt;
                &lt;div className="flex items-center justify-between mb-1.5"&gt;
                  &lt;label className="block text-xs font-semibold text-slate-700"&gt;
                    Available Time Slots
                  &lt;/label&gt;
                  &lt;span className="text-[11px] text-slate-400"&gt;Strict conflict validation&lt;/span&gt;
                &lt;/div&gt;

                &lt;div className="grid grid-cols-4 gap-2 max-h-36 overflow-y-auto p-1 border border-slate-200 rounded-xl"&gt;
                  {availableSlots.map((slot) =&gt; (
                    &lt;button
                      key={slot.time}
                      type="button"
                      disabled={!slot.available}
                      onClick={() =&gt; setSelectedSlot(slot.time)}
                      className={`py-2 px-1 rounded-lg text-xs font-bold transition-all text-center ${
                        !slot.available
                          ? 'bg-slate-100 text-slate-400 line-through cursor-not-allowed border border-slate-200'
                          : selectedSlot === slot.time
                          ? 'bg-teal-600 text-white shadow-sm ring-2 ring-teal-600 ring-offset-1'
                          : 'bg-white text-slate-700 border border-slate-200 hover:bg-teal-50'
                      }`}
                    &gt;
                      {slot.displayTime}
                    &lt;/button&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Symptoms / Disease input */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Current Symptoms &amp; Health Concerns
                &lt;/label&gt;
                &lt;textarea
                  rows="2"
                  value={symptoms}
                  onChange={(e) =&gt; setSymptoms(e.target.value)}
                  placeholder="Describe what you are experiencing (e.g., chest tightness, joint swelling, skin rash)..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Known Medical Condition / Suspected Disease (Optional)
                &lt;/label&gt;
                &lt;input
                  type="text"
                  value={disease}
                  onChange={(e) =&gt; setDisease(e.target.value)}
                  placeholder="e.g. Hypertension, Migraine, Eczema"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setIsBookModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold hover:bg-slate-100"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={bookingLoading || !selectedSlot}
                  className="flex-1 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold shadow-md shadow-teal-600/20 disabled:opacity-50"
                &gt;
                  {bookingLoading ? 'Validating...' : 'Confirm Appointment'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ----------------- RESCHEDULE MODAL ----------------- */}
      {rescheduleModalOpen &amp;&amp; appoToReschedule &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;h3 className="text-base font-bold text-slate-900"&gt;
                Reschedule Appointment #{appoToReschedule.Appo_id}
              &lt;/h3&gt;
              &lt;button onClick={() =&gt; setRescheduleModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {rescheduleError &amp;&amp; (
              &lt;div className="mt-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs"&gt;
                {rescheduleError}
              &lt;/div&gt;
            )}

            &lt;form onSubmit={handleRescheduleSubmit} className="mt-4 space-y-4"&gt;
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;New Date&lt;/label&gt;
                &lt;input
                  type="date"
                  required
                  min={new Date().toISOString().split('T')[0]}
                  value={newDate}
                  onChange={(e) =&gt; handleRescheduleDateChange(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-teal-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1.5"&gt;New Time Slot&lt;/label&gt;
                &lt;div className="grid grid-cols-4 gap-2 max-h-36 overflow-y-auto p-1 border border-slate-200 rounded-xl"&gt;
                  {newSlots.map((slot) =&gt; (
                    &lt;button
                      key={slot.time}
                      type="button"
                      disabled={!slot.available}
                      onClick={() =&gt; setNewSlot(slot.time)}
                      className={`py-2 px-1 rounded-lg text-xs font-bold text-center ${
                        !slot.available
                          ? 'bg-slate-100 text-slate-400 line-through'
                          : newSlot === slot.time
                          ? 'bg-teal-600 text-white shadow-sm'
                          : 'bg-white text-slate-700 border border-slate-200 hover:bg-teal-50'
                      }`}
                    &gt;
                      {slot.displayTime}
                    &lt;/button&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setRescheduleModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Close
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={rescheduleLoading}
                  className="flex-1 py-2.5 rounded-xl bg-teal-600 text-white text-xs font-bold hover:bg-teal-700"
                &gt;
                  {rescheduleLoading ? 'Updating...' : 'Save Reschedule'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ----------------- PRESCRIPTION &amp; CLINICAL NOTES MODAL ----------------- */}
      {viewPrescriptionModal &amp;&amp; activePrescriptionAppo &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200"&gt;
            &lt;div className="flex items-center justify-between pb-4 border-b border-slate-100"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;FileText className="w-5 h-5 text-teal-600" /&gt;
                &lt;h3 className="text-base font-bold text-slate-900"&gt;
                  Medical Consultation Record #{activePrescriptionAppo.Appo_id}
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button onClick={() =&gt; setViewPrescriptionModal(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="mt-4 space-y-4 text-xs"&gt;
              &lt;div className="p-3 bg-slate-50 rounded-xl border border-slate-100 space-y-1"&gt;
                &lt;p className="font-semibold text-slate-800"&gt;
                  Consulting Doctor: {activePrescriptionAppo.Doctor_name} ({activePrescriptionAppo.Specialization})
                &lt;/p&gt;
                &lt;p className="text-slate-500"&gt;Date: {activePrescriptionAppo.Appo_date} at {activePrescriptionAppo.Appo_time?.slice(0, 5)}&lt;/p&gt;
              &lt;/div&gt;

              {activePrescriptionAppo.Disease &amp;&amp; (
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-800 block mb-1"&gt;Diagnosed Condition:&lt;/span&gt;
                  &lt;div className="p-2.5 bg-teal-50/50 border border-teal-100 rounded-xl text-teal-900 font-medium"&gt;
                    {activePrescriptionAppo.Disease}
                  &lt;/div&gt;
                &lt;/div&gt;
              )}

              &lt;div&gt;
                &lt;span className="font-bold text-slate-800 block mb-1"&gt;Prescription &amp; Medication:&lt;/span&gt;
                &lt;div className="p-3 bg-emerald-50/50 border border-emerald-100 rounded-xl text-emerald-950 font-mono whitespace-pre-wrap"&gt;
                  {activePrescriptionAppo.Prescription || 'No medications prescribed.'}
                &lt;/div&gt;
              &lt;/div&gt;

              {activePrescriptionAppo.Doctor_notes &amp;&amp; (
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-800 block mb-1"&gt;Doctor Advice / Clinical Notes:&lt;/span&gt;
                  &lt;div className="p-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-700 whitespace-pre-wrap"&gt;
                    {activePrescriptionAppo.Doctor_notes}
                  &lt;/div&gt;
                &lt;/div&gt;
              )}

              {activePrescriptionAppo.Surgery_decision &amp;&amp; (
                &lt;div className="p-3 bg-purple-50 border border-purple-200 rounded-xl text-purple-900 font-semibold flex items-center gap-2"&gt;
                  &lt;Activity className="w-4 h-4 text-purple-600" /&gt;
                  &lt;span&gt;Surgery Evaluation: {activePrescriptionAppo.Surgery_decision}&lt;/span&gt;
                &lt;/div&gt;
              )}
            &lt;/div&gt;

            &lt;div className="mt-6 pt-3 border-t border-slate-100"&gt;
              &lt;button
                onClick={() =&gt; setViewPrescriptionModal(false)}
                className="w-full py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800"
              &gt;
                Close Record
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
};

export default PatientDashboard;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      30. Doctor Console Dashboard
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/src/pages/doctor/DoctorDashboard.jsx</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">8. FRONTEND DASHBOARDS & USER INTERFACES</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Specialist console: daily patient queue, symptoms analysis modal, prescription writer, consultation status updater (Seen/No-Show), surgery approval/rejection modal, and availability settings.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState, useEffect } from 'react';
import { useAuth } from '../../context/AuthContext';
import api from '../../services/api';
import {
  Stethoscope,
  Calendar,
  Clock,
  User,
  Activity,
  FileText,
  CheckCircle2,
  XCircle,
  AlertCircle,
  Settings,
  Phone,
  MapPin,
  RefreshCw,
  Edit3,
  X,
  Send,
  Sliders,
  Scissors
} from 'lucide-react';

const DoctorDashboard = () =&gt; {
  const { user } = useAuth();

  const [appointments, setAppointments] = useState([]);
  const [stats, setStats] = useState({ todayCount: 0, pendingCount: 0, surgeryCount: 0, totalCount: 0 });
  const [selectedDate, setSelectedDate] = useState('');
  const [statusFilter, setStatusFilter] = useState('All');
  const [loading, setLoading] = useState(true);

  // Clinical Consultation Modal State
  const [consultModalOpen, setConsultModalOpen] = useState(false);
  const [activeAppo, setActiveAppo] = useState(null);
  const [diseaseInput, setDiseaseInput] = useState('');
  const [prescriptionInput, setPrescriptionInput] = useState('');
  const [notesInput, setNotesInput] = useState('');
  const [statusInput, setStatusInput] = useState('Seen');
  const [savingRecord, setSavingRecord] = useState(false);

  // Surgery Decision Modal State
  const [surgeryModalOpen, setSurgeryModalOpen] = useState(false);
  const [surgeryAppo, setSurgeryAppo] = useState(null);
  const [surgeryDecision, setSurgeryDecision] = useState('Approved');
  const [surgeryNotes, setSurgeryNotes] = useState('');
  const [savingSurgery, setSavingSurgery] = useState(false);

  // Availability Settings Modal State
  const [availModalOpen, setAvailModalOpen] = useState(false);
  const [availString, setAvailString] = useState(user?.availability || 'Mon-Fri 09:00-17:00');
  const [phoneString, setPhoneString] = useState(user?.phone || '');
  const [roomString, setRoomString] = useState(user?.room_no || 'Room 101');
  const [savingAvail, setSavingAvail] = useState(false);

  useEffect(() =&gt; {
    fetchDoctorData();
  }, [selectedDate, statusFilter]);

  const fetchDoctorData = async () =&gt; {
    setLoading(true);
    try {
      let url = '/doctor/appointments?';
      if (selectedDate) url += `date=${selectedDate}&amp;`;
      if (statusFilter &amp;&amp; statusFilter !== 'All') url += `status=${statusFilter}&amp;`;

      const [appoRes, statsRes] = await Promise.all([
        api.get(url),
        api.get('/doctor/stats')
      ]);

      if (appoRes.data.success) setAppointments(appoRes.data.appointments || []);
      if (statsRes.data.success) setStats(statsRes.data.stats || {});
    } catch (err) {
      console.error('Failed to load doctor console data:', err);
    } finally {
      setLoading(false);
    }
  };

  const openConsultModal = (appo) =&gt; {
    setActiveAppo(appo);
    setDiseaseInput(appo.Disease || '');
    setPrescriptionInput(appo.Prescription || '');
    setNotesInput(appo.Doctor_notes || '');
    setStatusInput(appo.Status === 'Confirmed' || appo.Status === 'Pending' ? 'Seen' : appo.Status);
    setConsultModalOpen(true);
  };

  const handleSaveConsult = async (e) =&gt; {
    e.preventDefault();
    setSavingRecord(true);
    try {
      const res = await api.put(`/doctor/appointments/${activeAppo.Appo_id}/clinical`, {
        disease: diseaseInput,
        prescription: prescriptionInput,
        doctor_notes: notesInput,
        status: statusInput
      });

      if (res.data.success) {
        setConsultModalOpen(false);
        fetchDoctorData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to update clinical record.');
    } finally {
      setSavingRecord(false);
    }
  };

  const openSurgeryModal = (appo) =&gt; {
    setSurgeryAppo(appo);
    setSurgeryDecision(appo.Surgery_decision || 'Approved');
    setSurgeryNotes(appo.Doctor_notes || '');
    setSurgeryModalOpen(true);
  };

  const handleSaveSurgery = async (e) =&gt; {
    e.preventDefault();
    setSavingSurgery(true);
    try {
      const res = await api.put(`/doctor/appointments/${surgeryAppo.Appo_id}/surgery-decision`, {
        decision: surgeryDecision,
        notes: surgeryNotes
      });

      if (res.data.success) {
        setSurgeryModalOpen(false);
        fetchDoctorData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to save surgery evaluation.');
    } finally {
      setSavingSurgery(false);
    }
  };

  const handleSaveAvailability = async (e) =&gt; {
    e.preventDefault();
    setSavingAvail(true);
    try {
      const res = await api.put('/doctor/availability', {
        availability: availString,
        phone: phoneString,
        room_no: roomString
      });

      if (res.data.success) {
        setAvailModalOpen(false);
        alert('Availability schedule updated!');
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to update schedule.');
    } finally {
      setSavingAvail(false);
    }
  };

  const getStatusBadge = (status) =&gt; {
    switch (status) {
      case 'Seen':
      case 'Completed':
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200"&gt;Seen / Completed&lt;/span&gt;;
      case 'Approved for Surgery':
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200"&gt;Surgery Approved&lt;/span&gt;;
      case 'Rejected for Surgery':
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200"&gt;Non-Surgical&lt;/span&gt;;
      case 'No-Show':
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700"&gt;No-Show&lt;/span&gt;;
      case 'Cancelled':
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800"&gt;Cancelled&lt;/span&gt;;
      default:
        return &lt;span className="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200"&gt;Confirmed / Scheduled&lt;/span&gt;;
    }
  };

  return (
    &lt;div className="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8"&gt;
      &lt;div className="max-w-7xl mx-auto space-y-8"&gt;
        {/* Doctor Header Banner */}
        &lt;div className="bg-gradient-to-r from-emerald-800 via-teal-800 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6"&gt;
          &lt;div className="space-y-2"&gt;
            &lt;div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/30 text-emerald-200 text-xs font-semibold backdrop-blur-xs"&gt;
              &lt;Stethoscope className="w-3.5 h-3.5" /&gt; Department of {user?.specialization || 'Medicine'}
            &lt;/div&gt;
            &lt;h1 className="text-2xl sm:text-3xl font-extrabold tracking-tight"&gt;
              {user?.name}
            &lt;/h1&gt;
            &lt;p className="text-xs sm:text-sm text-emerald-100 flex items-center gap-3"&gt;
              &lt;span&gt;{user?.room_no || 'Consultation Suite Room 101'}&lt;/span&gt;
              &lt;span&gt;•&lt;/span&gt;
              &lt;span&gt;Availability: {user?.availability || 'Mon-Fri 09:00-17:00'}&lt;/span&gt;
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;div className="flex flex-wrap gap-3"&gt;
            &lt;button
              onClick={() =&gt; setAvailModalOpen(true)}
              className="px-4 py-2.5 rounded-xl bg-white text-emerald-900 font-bold text-xs shadow-md hover:bg-emerald-50 transition-all flex items-center gap-2"
            &gt;
              &lt;Sliders className="w-4 h-4 text-emerald-700" /&gt; Manage Schedule &amp; Hours
            &lt;/button&gt;
            &lt;button
              onClick={fetchDoctorData}
              className="p-2.5 rounded-xl bg-emerald-800/80 hover:bg-emerald-700/80 text-white transition-colors"
              title="Refresh Queue"
            &gt;
              &lt;RefreshCw className="w-4 h-4" /&gt;
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Doctor KPI Stats Strip */}
        &lt;div className="grid grid-cols-1 sm:grid-cols-4 gap-4"&gt;
          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold"&gt;
              &lt;Clock className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Today's Appointments&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{stats.todayCount || 0}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold"&gt;
              &lt;User className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Pending Review&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{stats.pendingCount || 0}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold"&gt;
              &lt;Activity className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Surgeries Cleared&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{stats.surgeryCount || 0}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold"&gt;
              &lt;FileText className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;p className="text-xs text-slate-500 font-medium"&gt;Total Consultations&lt;/p&gt;
              &lt;p className="text-2xl font-bold text-slate-900"&gt;{stats.totalCount || 0}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Filters Toolbar */}
        &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row justify-between items-center gap-4"&gt;
          &lt;div className="flex items-center gap-3 w-full sm:w-auto"&gt;
            &lt;label className="text-xs font-bold text-slate-700"&gt;Filter Date:&lt;/label&gt;
            &lt;input
              type="date"
              value={selectedDate}
              onChange={(e) =&gt; setSelectedDate(e.target.value)}
              className="px-3 py-1.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
            /&gt;
            {selectedDate &amp;&amp; (
              &lt;button
                onClick={() =&gt; setSelectedDate('')}
                className="text-xs text-rose-600 font-semibold hover:underline"
              &gt;
                Clear
              &lt;/button&gt;
            )}
          &lt;/div&gt;

          &lt;div className="flex flex-wrap gap-1.5 w-full sm:w-auto"&gt;
            {['All', 'Confirmed', 'Seen', 'Approved for Surgery', 'Cancelled'].map((st) =&gt; (
              &lt;button
                key={st}
                onClick={() =&gt; setStatusFilter(st)}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
                  statusFilter === st
                    ? 'bg-emerald-600 text-white shadow-xs'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              &gt;
                {st}
              &lt;/button&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Patient Appointments Queue List */}
        &lt;div className="space-y-4"&gt;
          {loading ? (
            &lt;div className="text-center py-12 text-slate-400"&gt;Loading patient queue...&lt;/div&gt;
          ) : appointments.length === 0 ? (
            &lt;div className="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-3"&gt;
              &lt;CheckCircle2 className="w-12 h-12 text-slate-300 mx-auto" /&gt;
              &lt;h3 className="font-bold text-slate-800 text-base"&gt;No Appointments Found&lt;/h3&gt;
              &lt;p className="text-xs text-slate-500"&gt;There are no patient bookings matching your active filters.&lt;/p&gt;
            &lt;/div&gt;
          ) : (
            &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;
              {appointments.map((appo) =&gt; (
                &lt;div
                  key={appo.Appo_id}
                  className="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between"
                &gt;
                  &lt;div className="space-y-3"&gt;
                    {/* Header */}
                    &lt;div className="flex items-start justify-between"&gt;
                      &lt;div&gt;
                        &lt;span className="text-[10px] font-mono font-bold text-slate-400"&gt;
                          Appo #{appo.Appo_id}
                        &lt;/span&gt;
                        &lt;h3 className="text-base font-bold text-slate-900"&gt;{appo.Patient_name}&lt;/h3&gt;
                        &lt;p className="text-xs text-slate-500"&gt;
                          Age: {appo.Patient_age} • {appo.Patient_place || 'Nilambur'}
                        &lt;/p&gt;
                      &lt;/div&gt;
                      &lt;div&gt;{getStatusBadge(appo.Status)}&lt;/div&gt;
                    &lt;/div&gt;

                    {/* Time / Contact info */}
                    &lt;div className="grid grid-cols-2 gap-2 p-2.5 rounded-xl bg-slate-50 text-xs text-slate-700 border border-slate-100"&gt;
                      &lt;div className="flex items-center gap-1.5"&gt;
                        &lt;Calendar className="w-3.5 h-3.5 text-emerald-600 shrink-0" /&gt;
                        &lt;span className="font-semibold"&gt;{appo.Appo_date}&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;div className="flex items-center gap-1.5"&gt;
                        &lt;Clock className="w-3.5 h-3.5 text-emerald-600 shrink-0" /&gt;
                        &lt;span className="font-semibold"&gt;{appo.Appo_time?.slice(0, 5)}&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;div className="flex items-center gap-1.5 col-span-2 text-slate-500 text-[11px]"&gt;
                        &lt;Phone className="w-3.5 h-3.5 text-slate-400 shrink-0" /&gt;
                        &lt;span&gt;{appo.Patient_phone}&lt;/span&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;

                    {/* Patient Symptoms */}
                    {appo.Symptoms &amp;&amp; (
                      &lt;div className="text-xs space-y-1"&gt;
                        &lt;span className="font-semibold text-slate-800"&gt;Patient Symptoms / Complaint:&lt;/span&gt;
                        &lt;p className="text-slate-600 italic bg-amber-50/60 p-2.5 rounded-xl border border-amber-200/60"&gt;
                          "{appo.Symptoms}"
                        &lt;/p&gt;
                      &lt;/div&gt;
                    )}

                    {/* Disease / Prescription Summary if already done */}
                    {appo.Disease &amp;&amp; (
                      &lt;div className="text-xs"&gt;
                        &lt;span className="font-semibold text-slate-800"&gt;Verified Condition:&lt;/span&gt;{' '}
                        &lt;span className="text-emerald-700 font-medium"&gt;{appo.Disease}&lt;/span&gt;
                      &lt;/div&gt;
                    )}

                    {appo.Prescription &amp;&amp; (
                      &lt;div className="text-xs"&gt;
                        &lt;span className="font-semibold text-slate-800"&gt;Prescription:&lt;/span&gt;{' '}
                        &lt;span className="text-slate-600 font-mono text-[11px] block truncate"&gt;{appo.Prescription}&lt;/span&gt;
                      &lt;/div&gt;
                    )}
                  &lt;/div&gt;

                  {/* Actions Bar */}
                  &lt;div className="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2"&gt;
                    &lt;button
                      onClick={() =&gt; openConsultModal(appo)}
                      className="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs shadow-emerald-600/20"
                    &gt;
                      &lt;Edit3 className="w-3.5 h-3.5" /&gt; Clinical Consultation &amp; Rx
                    &lt;/button&gt;

                    &lt;button
                      onClick={() =&gt; openSurgeryModal(appo)}
                      className="px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 text-xs font-bold flex items-center gap-1.5 border border-purple-200"
                    &gt;
                      &lt;Scissors className="w-3.5 h-3.5 text-purple-600" /&gt; Surgery Request
                    &lt;/button&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              ))}
            &lt;/div&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;

      {/* ----------------- CLINICAL CONSULTATION MODAL ----------------- */}
      {consultModalOpen &amp;&amp; activeAppo &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in max-h-[90vh] overflow-y-auto"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;div&gt;
                &lt;span className="text-[10px] font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-full"&gt;
                  Consultation
                &lt;/span&gt;
                &lt;h3 className="text-base font-bold text-slate-900 mt-1"&gt;
                  Patient: {activeAppo.Patient_name} (Age: {activeAppo.Patient_age})
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button onClick={() =&gt; setConsultModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;form onSubmit={handleSaveConsult} className="mt-4 space-y-4"&gt;
              {activeAppo.Symptoms &amp;&amp; (
                &lt;div className="p-3 bg-slate-50 border border-slate-100 rounded-xl text-xs"&gt;
                  &lt;span className="font-semibold text-slate-800 block mb-1"&gt;Presented Symptoms:&lt;/span&gt;
                  &lt;p className="text-slate-600"&gt;{activeAppo.Symptoms}&lt;/p&gt;
                &lt;/div&gt;
              )}

              {/* Disease Verification */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Diagnosed Condition / Disease Verification
                &lt;/label&gt;
                &lt;input
                  type="text"
                  required
                  value={diseaseInput}
                  onChange={(e) =&gt; setDiseaseInput(e.target.value)}
                  placeholder="e.g. Stage 1 Essential Hypertension, Acute Bronchitis"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              {/* Prescription */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Prescription &amp; Medicine Dosage
                &lt;/label&gt;
                &lt;textarea
                  rows="3"
                  value={prescriptionInput}
                  onChange={(e) =&gt; setPrescriptionInput(e.target.value)}
                  placeholder="e.g.&amp;#10;1. Tab Metoprolol 25mg - 1-0-1 (after meals) for 14 days&amp;#10;2. Tab Aspirin 75mg - 0-1-0"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              {/* Doctor Clinical Notes */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Doctor Advice / Clinical Observations
                &lt;/label&gt;
                &lt;textarea
                  rows="2"
                  value={notesInput}
                  onChange={(e) =&gt; setNotesInput(e.target.value)}
                  placeholder="e.g. Advised low sodium diet, avoid strenuous exertion, review in 2 weeks."
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              {/* Status Selector */}
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Consultation Status
                &lt;/label&gt;
                &lt;select
                  value={statusInput}
                  onChange={(e) =&gt; setStatusInput(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                &gt;
                  &lt;option value="Seen"&gt;Seen (Consultation Completed)&lt;/option&gt;
                  &lt;option value="Completed"&gt;Completed&lt;/option&gt;
                  &lt;option value="No-Show"&gt;No-Show (Patient absent)&lt;/option&gt;
                &lt;/select&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setConsultModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={savingRecord}
                  className="flex-1 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 shadow-md shadow-emerald-600/20"
                &gt;
                  {savingRecord ? 'Updating...' : 'Save &amp; Prescribe'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ----------------- SURGERY DECISION MODAL (DFD Level 2.2.1) ----------------- */}
      {surgeryModalOpen &amp;&amp; surgeryAppo &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;Scissors className="w-5 h-5 text-purple-600" /&gt;
                &lt;h3 className="text-base font-bold text-slate-900"&gt;
                  Surgery Evaluation for {surgeryAppo.Patient_name}
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button onClick={() =&gt; setSurgeryModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;form onSubmit={handleSaveSurgery} className="mt-4 space-y-4"&gt;
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-2"&gt;
                  Surgical Decision
                &lt;/label&gt;
                &lt;div className="grid grid-cols-2 gap-3"&gt;
                  &lt;button
                    type="button"
                    onClick={() =&gt; setSurgeryDecision('Approved')}
                    className={`py-3 px-4 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-2 ${
                      surgeryDecision === 'Approved'
                        ? 'bg-purple-600 text-white border-purple-600 shadow-sm'
                        : 'bg-white text-slate-700 border-slate-200 hover:bg-purple-50'
                    }`}
                  &gt;
                    &lt;CheckCircle2 className="w-4 h-4" /&gt; Approve Surgery
                  &lt;/button&gt;

                  &lt;button
                    type="button"
                    onClick={() =&gt; setSurgeryDecision('Rejected')}
                    className={`py-3 px-4 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-2 ${
                      surgeryDecision === 'Rejected'
                        ? 'bg-amber-600 text-white border-amber-600 shadow-sm'
                        : 'bg-white text-slate-700 border-slate-200 hover:bg-amber-50'
                    }`}
                  &gt;
                    &lt;XCircle className="w-4 h-4" /&gt; Non-Surgical / Reject
                  &lt;/button&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Surgical / Pre-Op Notes &amp; Justification
                &lt;/label&gt;
                &lt;textarea
                  rows="3"
                  value={surgeryNotes}
                  onChange={(e) =&gt; setSurgeryNotes(e.target.value)}
                  placeholder="e.g. Patient cleared for arthroscopic reconstruction under regional anesthesia..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setSurgeryModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={savingSurgery}
                  className="flex-1 py-2.5 rounded-xl bg-purple-600 text-white text-xs font-bold hover:bg-purple-700 shadow-md shadow-purple-600/20"
                &gt;
                  {savingSurgery ? 'Saving...' : 'Submit Decision'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ----------------- AVAILABILITY SETTINGS MODAL ----------------- */}
      {availModalOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;Sliders className="w-5 h-5 text-emerald-600" /&gt;
                &lt;h3 className="text-base font-bold text-slate-900"&gt;
                  Update Working Hours &amp; Clinic Room
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button onClick={() =&gt; setAvailModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;form onSubmit={handleSaveAvailability} className="mt-4 space-y-4"&gt;
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Availability Schedule String
                &lt;/label&gt;
                &lt;input
                  type="text"
                  required
                  value={availString}
                  onChange={(e) =&gt; setAvailString(e.target.value)}
                  placeholder="e.g. Mon-Fri 09:00-16:00"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Clinic Consultation Room
                &lt;/label&gt;
                &lt;input
                  type="text"
                  value={roomString}
                  onChange={(e) =&gt; setRoomString(e.target.value)}
                  placeholder="e.g. Cardio Wing A-204"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Doctor Direct Extension / Phone
                &lt;/label&gt;
                &lt;input
                  type="text"
                  value={phoneString}
                  onChange={(e) =&gt; setPhoneString(e.target.value)}
                  placeholder="+1 (555) 234-5671"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setAvailModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={savingAvail}
                  className="flex-1 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 shadow-md shadow-emerald-600/20"
                &gt;
                  {savingAvail ? 'Saving...' : 'Update Schedule'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
};

export default DoctorDashboard;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      31. Administrator Master Dashboard
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/src/pages/admin/AdminDashboard.jsx</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">8. FRONTEND DASHBOARDS & USER INTERFACES</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Admin command center: KPI analytics & reports, Doctor CRUD management organized by 4 specialties, centralized master appointment scheduler, patient directory, and admin password reset.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">import React, { useState, useEffect } from 'react';
import { useAuth } from '../../context/AuthContext';
import api from '../../services/api';
import {
  ShieldCheck,
  Users,
  Stethoscope,
  Calendar,
  Activity,
  PlusCircle,
  Edit2,
  Trash2,
  RefreshCw,
  Search,
  CheckCircle2,
  XCircle,
  AlertTriangle,
  Lock,
  Phone,
  Mail,
  Clock,
  MapPin,
  Building,
  KeyRound,
  X,
  Sliders,
  Filter
} from 'lucide-react';

const AdminDashboard = () =&gt; {
  const { user } = useAuth();

  const [activeTab, setActiveTab] = useState('analytics'); // 'analytics' | 'doctors' | 'appointments' | 'patients' | 'security'
  const [stats, setStats] = useState(null);
  const [doctors, setDoctors] = useState([]);
  const [appointments, setAppointments] = useState([]);
  const [patients, setPatients] = useState([]);
  const [loading, setLoading] = useState(true);

  // Doctor Filter &amp; CRUD State
  const [selectedSpecFilter, setSelectedSpecFilter] = useState('All');
  const [doctorModalOpen, setDoctorModalOpen] = useState(false);
  const [editingDoctor, setEditingDoctor] = useState(null);
  const [doctorForm, setDoctorForm] = useState({
    name: '',
    specialization: 'Cardiology',
    availability: 'Mon-Fri 09:00-17:00',
    email: '',
    password: '',
    phone: '',
    experience_years: 5,
    room_no: 'Room 101'
  });
  const [doctorModalLoading, setDoctorModalLoading] = useState(false);
  const [doctorModalError, setDoctorModalError] = useState('');

  // Master Appointments Filter &amp; Action State
  const [appoSearch, setAppoSearch] = useState('');
  const [appoStatusFilter, setAppoStatusFilter] = useState('All');
  const [rescheduleModalOpen, setRescheduleModalOpen] = useState(false);
  const [selectedAppoToEdit, setSelectedAppoToEdit] = useState(null);
  const [rescheduleForm, setRescheduleForm] = useState({
    new_doc_id: '',
    new_date: '',
    new_time: '10:00',
    status: 'Confirmed'
  });

  // Admin Security Password State
  const [currentPassword, setCurrentPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [passwordMsg, setPasswordMsg] = useState({ type: '', text: '' });
  const [passwordLoading, setPasswordLoading] = useState(false);

  useEffect(() =&gt; {
    fetchAdminData();
  }, [selectedSpecFilter]);

  const fetchAdminData = async () =&gt; {
    setLoading(true);
    try {
      let docUrl = '/admin/doctors';
      if (selectedSpecFilter &amp;&amp; selectedSpecFilter !== 'All') {
        docUrl += `?specialization=${selectedSpecFilter}`;
      }

      const [statsRes, docRes, appoRes, patRes] = await Promise.all([
        api.get('/admin/dashboard-stats'),
        api.get(docUrl),
        api.get('/admin/appointments'),
        api.get('/admin/patients')
      ]);

      if (statsRes.data.success) setStats(statsRes.data.stats);
      if (docRes.data.success) setDoctors(docRes.data.doctors || []);
      if (appoRes.data.success) setAppointments(appoRes.data.appointments || []);
      if (patRes.data.success) setPatients(patRes.data.patients || []);
    } catch (err) {
      console.error('Failed to load admin data:', err);
    } finally {
      setLoading(false);
    }
  };

  // Open Doctor Modal (Add or Edit)
  const openDoctorModal = (doc = null) =&gt; {
    setDoctorModalError('');
    if (doc) {
      setEditingDoctor(doc);
      setDoctorForm({
        name: doc.Name,
        specialization: doc.Specialization,
        availability: doc.Availability,
        email: doc.Email,
        password: '',
        phone: doc.Phone || '',
        experience_years: doc.Experience_years || 5,
        room_no: doc.Room_no || 'Room 101'
      });
    } else {
      setEditingDoctor(null);
      setDoctorForm({
        name: '',
        specialization: selectedSpecFilter !== 'All' ? selectedSpecFilter : 'Cardiology',
        availability: 'Mon-Fri 09:00-17:00',
        email: '',
        password: '',
        phone: '',
        experience_years: 5,
        room_no: 'Room 101'
      });
    }
    setDoctorModalOpen(true);
  };

  const handleDoctorSubmit = async (e) =&gt; {
    e.preventDefault();
    setDoctorModalError('');
    setDoctorModalLoading(true);

    try {
      if (editingDoctor) {
        // Update
        const res = await api.put(`/admin/doctors/${editingDoctor.Doc_id}`, doctorForm);
        if (res.data.success) {
          setDoctorModalOpen(false);
          fetchAdminData();
        }
      } else {
        // Create
        if (!doctorForm.password) {
          setDoctorModalError('Password is required for new doctor account.');
          setDoctorModalLoading(false);
          return;
        }
        const res = await api.post('/admin/doctors', doctorForm);
        if (res.data.success) {
          setDoctorModalOpen(false);
          fetchAdminData();
        }
      }
    } catch (err) {
      setDoctorModalError(err.response?.data?.message || 'Failed to save doctor.');
    } finally {
      setDoctorModalLoading(false);
    }
  };

  const handleDeleteDoctor = async (docId) =&gt; {
    if (!window.confirm('Are you sure you want to remove this doctor from faculty? Associated appointments will be handled.')) return;
    try {
      const res = await api.delete(`/admin/doctors/${docId}`);
      if (res.data.success) {
        fetchAdminData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to delete doctor.');
    }
  };

  // Reschedule / Conflict Resolve
  const openRescheduleModal = (appo) =&gt; {
    setSelectedAppoToEdit(appo);
    setRescheduleForm({
      new_doc_id: appo.Doc_id,
      new_date: appo.Appo_date,
      new_time: appo.Appo_time?.slice(0, 5) || '10:00',
      status: appo.Status
    });
    setRescheduleModalOpen(true);
  };

  const handleRescheduleSubmit = async (e) =&gt; {
    e.preventDefault();
    try {
      const res = await api.put(`/admin/appointments/${selectedAppoToEdit.Appo_id}/reschedule`, rescheduleForm);
      if (res.data.success) {
        setRescheduleModalOpen(false);
        fetchAdminData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Scheduling conflict or update error.');
    }
  };

  const handleAdminCancel = async (appoId) =&gt; {
    const reason = window.prompt('Please enter cancellation reason for the patient notification:', 'Administrative Schedule Adjustment');
    if (reason === null) return;

    try {
      const res = await api.put(`/admin/appointments/${appoId}/cancel`, { reason });
      if (res.data.success) {
        fetchAdminData();
      }
    } catch (err) {
      alert(err.response?.data?.message || 'Failed to cancel appointment.');
    }
  };

  // Change Admin Password
  const handlePasswordChange = async (e) =&gt; {
    e.preventDefault();
    setPasswordMsg({ type: '', text: '' });

    if (newPassword !== confirmPassword) {
      setPasswordMsg({ type: 'error', text: 'New passwords do not match.' });
      return;
    }

    if (newPassword.length &lt; 6) {
      setPasswordMsg({ type: 'error', text: 'Password must be at least 6 characters.' });
      return;
    }

    setPasswordLoading(true);
    try {
      const res = await api.put('/auth/change-admin-password', {
        currentPassword,
        newPassword
      });

      if (res.data.success) {
        setPasswordMsg({ type: 'success', text: 'Admin password updated successfully!' });
        setCurrentPassword('');
        setNewPassword('');
        setConfirmPassword('');
      }
    } catch (err) {
      setPasswordMsg({ type: 'error', text: err.response?.data?.message || 'Failed to update password.' });
    } finally {
      setPasswordLoading(false);
    }
  };

  // Filtered Appointments
  const filteredAppointments = appointments.filter((appo) =&gt; {
    const matchesStatus = appoStatusFilter === 'All' || appo.Status === appoStatusFilter;
    const matchesSearch = appo.Patient_name?.toLowerCase().includes(appoSearch.toLowerCase()) ||
                          appo.Doctor_name?.toLowerCase().includes(appoSearch.toLowerCase()) ||
                          appo.Specialization?.toLowerCase().includes(appoSearch.toLowerCase());
    return matchesStatus &amp;&amp; matchesSearch;
  });

  return (
    &lt;div className="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8"&gt;
      &lt;div className="max-w-7xl mx-auto space-y-8"&gt;
        {/* Admin Header */}
        &lt;div className="bg-gradient-to-r from-purple-900 via-indigo-900 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6"&gt;
          &lt;div className="space-y-2"&gt;
            &lt;div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-500/30 text-purple-200 text-xs font-semibold backdrop-blur-xs"&gt;
              &lt;ShieldCheck className="w-3.5 h-3.5" /&gt; Hospital Administration &amp; Control
            &lt;/div&gt;
            &lt;h1 className="text-2xl sm:text-3xl font-extrabold tracking-tight"&gt;
              Hospital Master Console
            &lt;/h1&gt;
            &lt;p className="text-xs sm:text-sm text-purple-200"&gt;
              Manage clinical departments (Cardiology, Neurology, Orthopedics, Dermatology), resolve scheduling conflicts, monitor KPIs, and oversee hospital accounts.
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;div className="flex flex-wrap gap-3"&gt;
            &lt;button
              onClick={() =&gt; openDoctorModal()}
              className="px-4 py-2.5 rounded-xl bg-purple-500 hover:bg-purple-600 text-white font-bold text-xs shadow-md transition-all flex items-center gap-2"
            &gt;
              &lt;PlusCircle className="w-4 h-4" /&gt; Add New Doctor
            &lt;/button&gt;
            &lt;button
              onClick={fetchAdminData}
              className="p-2.5 rounded-xl bg-purple-800/80 hover:bg-purple-700/80 text-white transition-colors"
              title="Refresh Data"
            &gt;
              &lt;RefreshCw className="w-4 h-4" /&gt;
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Tab Navigation */}
        &lt;div className="border-b border-slate-200 flex flex-wrap gap-4"&gt;
          &lt;button
            onClick={() =&gt; setActiveTab('analytics')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'analytics'
                ? 'border-purple-600 text-purple-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Activity className="w-4 h-4" /&gt; Reports &amp; Analytics
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('doctors')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'doctors'
                ? 'border-purple-600 text-purple-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Stethoscope className="w-4 h-4" /&gt; Doctor Management ({doctors.length})
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('appointments')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'appointments'
                ? 'border-purple-600 text-purple-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Calendar className="w-4 h-4" /&gt; Master Scheduler ({appointments.length})
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('patients')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'patients'
                ? 'border-purple-600 text-purple-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Users className="w-4 h-4" /&gt; Patients Directory ({patients.length})
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setActiveTab('security')}
            className={`pb-3 text-sm font-bold flex items-center gap-2 border-b-2 transition-all ${
              activeTab === 'security'
                ? 'border-purple-600 text-purple-600'
                : 'border-transparent text-slate-500 hover:text-slate-800'
            }`}
          &gt;
            &lt;Lock className="w-4 h-4" /&gt; Account Security
          &lt;/button&gt;
        &lt;/div&gt;

        {/* ---------------- TAB 1: REPORTS &amp; ANALYTICS ---------------- */}
        {activeTab === 'analytics' &amp;&amp; stats &amp;&amp; (
          &lt;div className="space-y-6"&gt;
            {/* Top 3 KPI Cards */}
            &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-4"&gt;
              &lt;div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
                &lt;div className="w-14 h-14 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold"&gt;
                  &lt;Users className="w-7 h-7" /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;p className="text-xs text-slate-500 font-semibold uppercase tracking-wider"&gt;Total Patients&lt;/p&gt;
                  &lt;p className="text-3xl font-extrabold text-slate-900"&gt;{stats.totalPatients}&lt;/p&gt;
                  &lt;p className="text-[11px] text-purple-600 font-medium mt-0.5"&gt;Registered Patient Records&lt;/p&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
                &lt;div className="w-14 h-14 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold"&gt;
                  &lt;Stethoscope className="w-7 h-7" /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;p className="text-xs text-slate-500 font-semibold uppercase tracking-wider"&gt;Active Doctors&lt;/p&gt;
                  &lt;p className="text-3xl font-extrabold text-slate-900"&gt;{stats.totalDoctors}&lt;/p&gt;
                  &lt;p className="text-[11px] text-teal-600 font-medium mt-0.5"&gt;Across 4 Specialties&lt;/p&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-4"&gt;
                &lt;div className="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold"&gt;
                  &lt;Calendar className="w-7 h-7" /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;p className="text-xs text-slate-500 font-semibold uppercase tracking-wider"&gt;Appointments Logged&lt;/p&gt;
                  &lt;p className="text-3xl font-extrabold text-slate-900"&gt;{stats.totalAppointments}&lt;/p&gt;
                  &lt;p className="text-[11px] text-blue-600 font-medium mt-0.5"&gt;All-time Hospital Bookings&lt;/p&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Status Breakdown &amp; Department Cards */}
            &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-6"&gt;
              {/* Status Breakdown */}
              &lt;div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4"&gt;
                &lt;h3 className="font-bold text-slate-900 text-base flex items-center gap-2"&gt;
                  &lt;Activity className="w-5 h-5 text-purple-600" /&gt; Appointment Status Distribution
                &lt;/h3&gt;
                &lt;div className="space-y-3"&gt;
                  {stats.statusBreakdown?.map((st) =&gt; (
                    &lt;div key={st.Status} className="space-y-1"&gt;
                      &lt;div className="flex justify-between text-xs font-semibold text-slate-700"&gt;
                        &lt;span&gt;{st.Status}&lt;/span&gt;
                        &lt;span&gt;{st.count} booking(s)&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;div className="w-full h-2 bg-slate-100 rounded-full overflow-hidden"&gt;
                        &lt;div
                          className="h-full bg-purple-600 rounded-full"
                          style={{ width: `${Math.min(100, (st.count / (stats.totalAppointments || 1)) * 100)}%` }}
                        &gt;&lt;/div&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Specialization Breakdown */}
              &lt;div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4"&gt;
                &lt;h3 className="font-bold text-slate-900 text-base flex items-center gap-2"&gt;
                  &lt;Building className="w-5 h-5 text-teal-600" /&gt; Doctors by Department
                &lt;/h3&gt;
                &lt;div className="grid grid-cols-2 gap-3"&gt;
                  {stats.specialtyBreakdown?.map((sp) =&gt; (
                    &lt;div key={sp.Specialization} className="p-4 rounded-xl bg-slate-50 border border-slate-200"&gt;
                      &lt;p className="text-xs font-bold text-slate-800"&gt;{sp.Specialization}&lt;/p&gt;
                      &lt;p className="text-xl font-extrabold text-teal-700 mt-1"&gt;{sp.count} Specialists&lt;/p&gt;
                    &lt;/div&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Recent Activity Table */}
            &lt;div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4"&gt;
              &lt;h3 className="font-bold text-slate-900 text-base"&gt;Recent Appointment Activity&lt;/h3&gt;
              &lt;div className="overflow-x-auto"&gt;
                &lt;table className="w-full text-left text-xs"&gt;
                  &lt;thead className="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold"&gt;
                    &lt;tr&gt;
                      &lt;th className="py-2.5 px-3"&gt;ID&lt;/th&gt;
                      &lt;th className="py-2.5 px-3"&gt;Patient&lt;/th&gt;
                      &lt;th className="py-2.5 px-3"&gt;Doctor &amp; Specialty&lt;/th&gt;
                      &lt;th className="py-2.5 px-3"&gt;Date &amp; Time&lt;/th&gt;
                      &lt;th className="py-2.5 px-3"&gt;Status&lt;/th&gt;
                    &lt;/tr&gt;
                  &lt;/thead&gt;
                  &lt;tbody className="divide-y divide-slate-100"&gt;
                    {stats.recentAppointments?.map((appo) =&gt; (
                      &lt;tr key={appo.Appo_id} className="hover:bg-slate-50"&gt;
                        &lt;td className="py-2.5 px-3 font-mono font-bold text-slate-400"&gt;#{appo.Appo_id}&lt;/td&gt;
                        &lt;td className="py-2.5 px-3 font-semibold text-slate-900"&gt;{appo.Patient_name}&lt;/td&gt;
                        &lt;td className="py-2.5 px-3 text-slate-700"&gt;{appo.Doctor_name} ({appo.Specialization})&lt;/td&gt;
                        &lt;td className="py-2.5 px-3 text-slate-500"&gt;{appo.Appo_date} at {appo.Appo_time?.slice(0, 5)}&lt;/td&gt;
                        &lt;td className="py-2.5 px-3"&gt;
                          &lt;span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700"&gt;
                            {appo.Status}
                          &lt;/span&gt;
                        &lt;/td&gt;
                      &lt;/tr&gt;
                    ))}
                  &lt;/tbody&gt;
                &lt;/table&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        )}

        {/* ---------------- TAB 2: DOCTOR MANAGEMENT (DFD 2.1.1, 2.1.2) ---------------- */}
        {activeTab === 'doctors' &amp;&amp; (
          &lt;div className="space-y-6"&gt;
            {/* Specialization Filter Pill Bar */}
            &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-wrap justify-between items-center gap-4"&gt;
              &lt;div className="flex flex-wrap gap-2"&gt;
                {['All', 'Cardiology', 'Neurology', 'Orthopedics', 'Dermatology'].map((cat) =&gt; (
                  &lt;button
                    key={cat}
                    onClick={() =&gt; setSelectedSpecFilter(cat)}
                    className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                      selectedSpecFilter === cat
                        ? 'bg-purple-600 text-white shadow-xs'
                        : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                    }`}
                  &gt;
                    {cat}
                  &lt;/button&gt;
                ))}
              &lt;/div&gt;

              &lt;button
                onClick={() =&gt; openDoctorModal()}
                className="px-4 py-2 bg-purple-600 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm hover:bg-purple-700"
              &gt;
                &lt;PlusCircle className="w-4 h-4" /&gt; Add Doctor
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Doctors Grid */}
            &lt;div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
              {doctors.map((doc) =&gt; (
                &lt;div
                  key={doc.Doc_id}
                  className="bg-white rounded-2xl border border-slate-200 p-5 space-y-4 shadow-xs hover:border-purple-300 transition-all flex flex-col justify-between"
                &gt;
                  &lt;div className="space-y-2"&gt;
                    &lt;div className="flex items-center justify-between"&gt;
                      &lt;span className="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-100"&gt;
                        {doc.Specialization}
                      &lt;/span&gt;
                      &lt;span className="text-xs text-slate-400"&gt;{doc.Experience_years || 5} Yrs Experience&lt;/span&gt;
                    &lt;/div&gt;

                    &lt;h3 className="text-base font-bold text-slate-900"&gt;{doc.Name}&lt;/h3&gt;
                    &lt;p className="text-xs text-slate-500"&gt;{doc.Room_no || 'Room 101'}&lt;/p&gt;

                    &lt;div className="pt-2 space-y-1.5 text-xs text-slate-600 border-t border-slate-100"&gt;
                      &lt;div className="flex items-center gap-2"&gt;
                        &lt;Clock className="w-3.5 h-3.5 text-purple-600 shrink-0" /&gt;
                        &lt;span className="truncate"&gt;{doc.Availability}&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;div className="flex items-center gap-2"&gt;
                        &lt;Mail className="w-3.5 h-3.5 text-slate-400 shrink-0" /&gt;
                        &lt;span className="truncate"&gt;{doc.Email}&lt;/span&gt;
                      &lt;/div&gt;
                      {doc.Phone &amp;&amp; (
                        &lt;div className="flex items-center gap-2"&gt;
                          &lt;Phone className="w-3.5 h-3.5 text-slate-400 shrink-0" /&gt;
                          &lt;span&gt;{doc.Phone}&lt;/span&gt;
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;
                  &lt;/div&gt;

                  &lt;div className="pt-3 border-t border-slate-100 flex items-center justify-between gap-2"&gt;
                    &lt;span className="text-[11px] text-slate-400 font-medium"&gt;
                      {doc.total_appointments || 0} appointments
                    &lt;/span&gt;
                    &lt;div className="flex gap-2"&gt;
                      &lt;button
                        onClick={() =&gt; openDoctorModal(doc)}
                        className="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700"
                        title="Edit Doctor"
                      &gt;
                        &lt;Edit2 className="w-4 h-4" /&gt;
                      &lt;/button&gt;
                      &lt;button
                        onClick={() =&gt; handleDeleteDoctor(doc.Doc_id)}
                        className="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600"
                        title="Remove Doctor"
                      &gt;
                        &lt;Trash2 className="w-4 h-4" /&gt;
                      &lt;/button&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              ))}
            &lt;/div&gt;
          &lt;/div&gt;
        )}

        {/* ---------------- TAB 3: MASTER APPOINTMENTS SCHEDULER ---------------- */}
        {activeTab === 'appointments' &amp;&amp; (
          &lt;div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4"&gt;
            &lt;div className="flex flex-col sm:flex-row justify-between items-center gap-4 pb-4 border-b border-slate-100"&gt;
              &lt;div className="flex items-center gap-3 w-full sm:w-auto"&gt;
                &lt;div className="relative flex-1 sm:w-64"&gt;
                  &lt;Search className="w-4 h-4 text-slate-400 absolute left-3 top-2.5" /&gt;
                  &lt;input
                    type="text"
                    placeholder="Search patient or doctor..."
                    value={appoSearch}
                    onChange={(e) =&gt; setAppoSearch(e.target.value)}
                    className="w-full pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="flex flex-wrap gap-1.5"&gt;
                {['All', 'Confirmed', 'Pending', 'Seen', 'Approved for Surgery', 'Cancelled'].map((st) =&gt; (
                  &lt;button
                    key={st}
                    onClick={() =&gt; setAppoStatusFilter(st)}
                    className={`px-3 py-1 rounded-xl text-xs font-bold transition-all ${
                      appoStatusFilter === st
                        ? 'bg-purple-600 text-white'
                        : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                    }`}
                  &gt;
                    {st}
                  &lt;/button&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="overflow-x-auto"&gt;
              &lt;table className="w-full text-left text-xs"&gt;
                &lt;thead className="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold"&gt;
                  &lt;tr&gt;
                    &lt;th className="py-3 px-3"&gt;ID&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Patient&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Assigned Doctor&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Specialty&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Date &amp; Time&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Status&lt;/th&gt;
                    &lt;th className="py-3 px-3 text-right"&gt;Actions&lt;/th&gt;
                  &lt;/tr&gt;
                &lt;/thead&gt;
                &lt;tbody className="divide-y divide-slate-100"&gt;
                  {filteredAppointments.map((appo) =&gt; (
                    &lt;tr key={appo.Appo_id} className="hover:bg-slate-50"&gt;
                      &lt;td className="py-3 px-3 font-mono font-bold text-slate-400"&gt;#{appo.Appo_id}&lt;/td&gt;
                      &lt;td className="py-3 px-3 font-bold text-slate-900"&gt;
                        &lt;div&gt;{appo.Patient_name}&lt;/div&gt;
                        &lt;div className="text-[11px] text-slate-400 font-normal"&gt;{appo.Patient_phone}&lt;/div&gt;
                      &lt;/td&gt;
                      &lt;td className="py-3 px-3 font-medium text-slate-800"&gt;{appo.Doctor_name}&lt;/td&gt;
                      &lt;td className="py-3 px-3"&gt;
                        &lt;span className="px-2 py-0.5 rounded-full text-[11px] bg-purple-50 text-purple-700 font-semibold border border-purple-100"&gt;
                          {appo.Specialization}
                        &lt;/span&gt;
                      &lt;/td&gt;
                      &lt;td className="py-3 px-3 text-slate-600 font-medium"&gt;
                        {appo.Appo_date} at {appo.Appo_time?.slice(0, 5)}
                      &lt;/td&gt;
                      &lt;td className="py-3 px-3"&gt;
                        &lt;span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-800"&gt;
                          {appo.Status}
                        &lt;/span&gt;
                      &lt;/td&gt;
                      &lt;td className="py-3 px-3 text-right space-x-1.5"&gt;
                        &lt;button
                          onClick={() =&gt; openRescheduleModal(appo)}
                          className="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-purple-50 hover:text-purple-700 text-slate-700 text-xs font-semibold"
                        &gt;
                          Reschedule / Conflict
                        &lt;/button&gt;
                        {appo.Status !== 'Cancelled' &amp;&amp; (
                          &lt;button
                            onClick={() =&gt; handleAdminCancel(appo.Appo_id)}
                            className="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold"
                          &gt;
                            Cancel
                          &lt;/button&gt;
                        )}
                      &lt;/td&gt;
                    &lt;/tr&gt;
                  ))}
                &lt;/tbody&gt;
              &lt;/table&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        )}

        {/* ---------------- TAB 4: PATIENTS DIRECTORY ---------------- */}
        {activeTab === 'patients' &amp;&amp; (
          &lt;div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4"&gt;
            &lt;h3 className="font-bold text-slate-900 text-base"&gt;Registered Hospital Patients&lt;/h3&gt;
            &lt;div className="overflow-x-auto"&gt;
              &lt;table className="w-full text-left text-xs"&gt;
                &lt;thead className="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold"&gt;
                  &lt;tr&gt;
                    &lt;th className="py-3 px-3"&gt;Patient ID&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Full Name&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Age&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Phone&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Email&lt;/th&gt;
                    &lt;th className="py-3 px-3"&gt;Place &amp; Address&lt;/th&gt;
                    &lt;th className="py-3 px-3 text-right"&gt;Appointments&lt;/th&gt;
                  &lt;/tr&gt;
                &lt;/thead&gt;
                &lt;tbody className="divide-y divide-slate-100"&gt;
                  {patients.map((pat) =&gt; (
                    &lt;tr key={pat.Patient_id} className="hover:bg-slate-50"&gt;
                      &lt;td className="py-3 px-3 font-mono font-bold text-slate-400"&gt;#{pat.Patient_id}&lt;/td&gt;
                      &lt;td className="py-3 px-3 font-bold text-slate-900"&gt;{pat.Name}&lt;/td&gt;
                      &lt;td className="py-3 px-3 text-slate-600"&gt;{pat.Age}&lt;/td&gt;
                      &lt;td className="py-3 px-3 font-mono text-slate-700"&gt;{pat.Phone}&lt;/td&gt;
                      &lt;td className="py-3 px-3 text-slate-500"&gt;{pat.Email || 'N/A'}&lt;/td&gt;
                      &lt;td className="py-3 px-3 text-slate-600"&gt;
                        {pat.Place ? `${pat.Place}, ` : ''}{pat.Address || 'N/A'}
                      &lt;/td&gt;
                      &lt;td className="py-3 px-3 text-right font-bold text-purple-700"&gt;
                        {pat.total_appointments || 0} visits
                      &lt;/td&gt;
                    &lt;/tr&gt;
                  ))}
                &lt;/tbody&gt;
              &lt;/table&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        )}

        {/* ---------------- TAB 5: ADMIN PASSWORD RESET &amp; SECURITY (DFD 2.1.3) ---------------- */}
        {activeTab === 'security' &amp;&amp; (
          &lt;div className="max-w-xl bg-white rounded-3xl border border-slate-200 p-8 shadow-xs space-y-6"&gt;
            &lt;div className="flex items-center gap-3 pb-4 border-b border-slate-100"&gt;
              &lt;div className="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold"&gt;
                &lt;KeyRound className="w-5 h-5" /&gt;
              &lt;/div&gt;
              &lt;div&gt;
                &lt;h3 className="text-base font-bold text-slate-900"&gt;Administrator Password Management&lt;/h3&gt;
                &lt;p className="text-xs text-slate-500"&gt;DFD Level 2.1.3 - Secure Admin Credentials Change&lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {passwordMsg.text &amp;&amp; (
              &lt;div
                className={`p-3.5 rounded-xl text-xs flex items-center gap-2 ${
                  passwordMsg.type === 'success'
                    ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'bg-rose-50 text-rose-700 border border-rose-200'
                }`}
              &gt;
                {passwordMsg.type === 'success' ? &lt;CheckCircle2 className="w-4 h-4" /&gt; : &lt;AlertTriangle className="w-4 h-4" /&gt;}
                &lt;span&gt;{passwordMsg.text}&lt;/span&gt;
              &lt;/div&gt;
            )}

            &lt;form onSubmit={handlePasswordChange} className="space-y-4"&gt;
              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Current Password
                &lt;/label&gt;
                &lt;input
                  type="password"
                  required
                  value={currentPassword}
                  onChange={(e) =&gt; setCurrentPassword(e.target.value)}
                  placeholder="Enter current admin password"
                  className="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  New Admin Password
                &lt;/label&gt;
                &lt;input
                  type="password"
                  required
                  value={newPassword}
                  onChange={(e) =&gt; setNewPassword(e.target.value)}
                  placeholder="Min 6 characters"
                  className="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
                  Confirm New Password
                &lt;/label&gt;
                &lt;input
                  type="password"
                  required
                  value={confirmPassword}
                  onChange={(e) =&gt; setConfirmPassword(e.target.value)}
                  placeholder="Confirm new password"
                  className="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="pt-2"&gt;
                &lt;button
                  type="submit"
                  disabled={passwordLoading}
                  className="w-full py-3 px-4 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-md shadow-purple-600/20"
                &gt;
                  {passwordLoading ? 'Updating Password...' : 'Update Admin Credentials'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        )}
      &lt;/div&gt;

      {/* ---------------- DOCTOR ADD/EDIT MODAL ---------------- */}
      {doctorModalOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in max-h-[90vh] overflow-y-auto"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;h3 className="text-base font-bold text-slate-900"&gt;
                {editingDoctor ? `Edit Doctor: ${editingDoctor.Name}` : 'Add New Medical Specialist'}
              &lt;/h3&gt;
              &lt;button onClick={() =&gt; setDoctorModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {doctorModalError &amp;&amp; (
              &lt;div className="mt-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs"&gt;
                {doctorModalError}
              &lt;/div&gt;
            )}

            &lt;form onSubmit={handleDoctorSubmit} className="mt-4 space-y-3.5 text-xs"&gt;
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Doctor Full Name&lt;/label&gt;
                &lt;input
                  type="text"
                  required
                  value={doctorForm.name}
                  onChange={(e) =&gt; setDoctorForm({ ...doctorForm, name: e.target.value })}
                  placeholder="e.g. Dr. Sarah Al-Mansoor"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="grid grid-cols-2 gap-3"&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Specialization&lt;/label&gt;
                  &lt;select
                    value={doctorForm.specialization}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, specialization: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  &gt;
                    &lt;option value="Cardiology"&gt;Cardiology&lt;/option&gt;
                    &lt;option value="Neurology"&gt;Neurology&lt;/option&gt;
                    &lt;option value="Orthopedics"&gt;Orthopedics&lt;/option&gt;
                    &lt;option value="Dermatology"&gt;Dermatology&lt;/option&gt;
                  &lt;/select&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Years Experience&lt;/label&gt;
                  &lt;input
                    type="number"
                    value={doctorForm.experience_years}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, experience_years: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Availability Schedule&lt;/label&gt;
                &lt;input
                  type="text"
                  required
                  value={doctorForm.availability}
                  onChange={(e) =&gt; setDoctorForm({ ...doctorForm, availability: e.target.value })}
                  placeholder="e.g. Mon-Fri 09:00-15:00"
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div className="grid grid-cols-2 gap-3"&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Email (Login ID)&lt;/label&gt;
                  &lt;input
                    type="email"
                    required
                    value={doctorForm.email}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, email: e.target.value })}
                    placeholder="doctor@hospital.org"
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;
                    {editingDoctor ? 'New Password (Optional)' : 'Account Password'}
                  &lt;/label&gt;
                  &lt;input
                    type="password"
                    required={!editingDoctor}
                    value={doctorForm.password}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, password: e.target.value })}
                    placeholder={editingDoctor ? 'Leave blank to keep' : 'Min 6 characters'}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="grid grid-cols-2 gap-3"&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Contact Phone&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={doctorForm.phone}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, phone: e.target.value })}
                    placeholder="+1 (555) 234-5671"
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Clinic Room No&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={doctorForm.room_no}
                    onChange={(e) =&gt; setDoctorForm({ ...doctorForm, room_no: e.target.value })}
                    placeholder="Cardio Suite A-204"
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="pt-3 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setDoctorModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={doctorModalLoading}
                  className="flex-1 py-2.5 rounded-xl bg-purple-600 text-white text-xs font-bold hover:bg-purple-700 shadow-md shadow-purple-600/20"
                &gt;
                  {doctorModalLoading ? 'Saving...' : editingDoctor ? 'Update Doctor' : 'Create Doctor Record'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ---------------- ADMIN RESCHEDULE / CONFLICT RESOLVE MODAL ---------------- */}
      {rescheduleModalOpen &amp;&amp; selectedAppoToEdit &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in"&gt;
            &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
              &lt;h3 className="text-base font-bold text-slate-900"&gt;
                Resolve Schedule &amp; Conflict (Appo #{selectedAppoToEdit.Appo_id})
              &lt;/h3&gt;
              &lt;button onClick={() =&gt; setRescheduleModalOpen(false)} className="text-slate-400"&gt;
                &lt;X className="w-5 h-5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;form onSubmit={handleRescheduleSubmit} className="mt-4 space-y-3.5 text-xs"&gt;
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Reassign Doctor&lt;/label&gt;
                &lt;select
                  value={rescheduleForm.new_doc_id}
                  onChange={(e) =&gt; setRescheduleForm({ ...rescheduleForm, new_doc_id: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                &gt;
                  {doctors.map((d) =&gt; (
                    &lt;option key={d.Doc_id} value={d.Doc_id}&gt;
                      {d.Name} ({d.Specialization})
                    &lt;/option&gt;
                  ))}
                &lt;/select&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Appointment Date&lt;/label&gt;
                &lt;input
                  type="date"
                  required
                  value={rescheduleForm.new_date}
                  onChange={(e) =&gt; setRescheduleForm({ ...rescheduleForm, new_date: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Appointment Time&lt;/label&gt;
                &lt;input
                  type="time"
                  required
                  value={rescheduleForm.new_time}
                  onChange={(e) =&gt; setRescheduleForm({ ...rescheduleForm, new_time: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;Booking Status&lt;/label&gt;
                &lt;select
                  value={rescheduleForm.status}
                  onChange={(e) =&gt; setRescheduleForm({ ...rescheduleForm, status: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-purple-500 outline-none"
                &gt;
                  &lt;option value="Confirmed"&gt;Confirmed&lt;/option&gt;
                  &lt;option value="Pending"&gt;Pending&lt;/option&gt;
                  &lt;option value="Seen"&gt;Seen&lt;/option&gt;
                  &lt;option value="Approved for Surgery"&gt;Approved for Surgery&lt;/option&gt;
                  &lt;option value="Cancelled"&gt;Cancelled&lt;/option&gt;
                &lt;/select&gt;
              &lt;/div&gt;

              &lt;div className="pt-2 flex gap-3"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setRescheduleModalOpen(false)}
                  className="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold"
                &gt;
                  Cancel
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  className="flex-1 py-2.5 rounded-xl bg-purple-600 text-white text-xs font-bold hover:bg-purple-700 shadow-md shadow-purple-600/20"
                &gt;
                  Save Schedule
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
};

export default AdminDashboard;
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      32. Docker Compose Stack Configuration
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>docker-compose.yml</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">9. CONTAINERIZATION & DEPLOYMENT</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Multi-container specification orchestrating MySQL 8.0, Node.js Backend API, and Nginx Frontend SPA in an isolated bridge network.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">services:
  mysql:
    image: mysql:8.0
    container_name: opas_mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: rootpassword
      MYSQL_DATABASE: opas_db
      MYSQL_USER: opas_user
      MYSQL_PASSWORD: opas_password
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ./backend/database/schema.sql:/docker-entrypoint-initdb.d/schema.sql
    networks:
      - opas_net

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile
    container_name: opas_backend
    restart: always
    environment:
      PORT: 5000
      JWT_SECRET: opas_super_secret_jwt_key_2026_healthcare
      DB_HOST: mysql
      DB_PORT: 3306
      DB_USER: opas_user
      DB_PASSWORD: opas_password
      DB_NAME: opas_db
      NODE_ENV: production
    ports:
      - "5000:5000"
    depends_on:
      - mysql
    networks:
      - opas_net

  frontend:
    build:
      context: .
      dockerfile: frontend/Dockerfile
    container_name: opas_frontend
    restart: always
    ports:
      - "80:80"
    depends_on:
      - backend
    networks:
      - opas_net

volumes:
  mysql_data:

networks:
  opas_net:
    driver: bridge
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      33. Backend Production Dockerfile
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>backend/Dockerfile</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">9. CONTAINERIZATION & DEPLOYMENT</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Container build definition for the Node.js Express REST API.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">FROM node:20-alpine

WORKDIR /app

COPY backend/package*.json ./
RUN npm install --production

COPY backend/ ./

EXPOSE 5000
CMD ["node", "server.js"]
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      34. Frontend Multi-Stage Dockerfile
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/Dockerfile</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">9. CONTAINERIZATION & DEPLOYMENT</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Builds the Vite React static application and serves it via an Alpine Nginx web server container.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
</div>
  </div>

  <div class="section-card">
    <div class="header-box">
      35. Nginx Reverse Proxy & SPA Router Config
    </div>
    <div class="meta-box">
      <table>
        <tr>
          <td class="meta-label">File Path:</td>
          <td><code>frontend/nginx.conf</code></td>
        </tr>
        <tr>
          <td class="meta-label">Category:</td>
          <td><span class="tag">9. CONTAINERIZATION & DEPLOYMENT</span></td>
        </tr>
        <tr>
          <td class="meta-label">Role & Purpose:</td>
          <td>Nginx server configuration for Single Page Application routing and /api reverse proxying to the backend service.</td>
        </tr>
      </table>
    </div>
    <div class="code-box">server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api {
        proxy_pass http://backend:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
</div>
  </div>
</body></html>